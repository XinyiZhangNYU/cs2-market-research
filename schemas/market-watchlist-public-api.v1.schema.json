{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cs2-research:market-watchlist-public-api:v1",
  "title": "CS2 public market and watchlist result API V1",
  "oneOf": [
    { "$ref": "#/$defs/marketOverviewResponse" },
    { "$ref": "#/$defs/marketHistoryResponse" },
    { "$ref": "#/$defs/watchlistResponse" },
    { "$ref": "#/$defs/watchlistDetailResponse" },
    { "$ref": "#/$defs/watchlistHistoryResponse" },
    { "$ref": "#/$defs/errorResponse" }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "identifier": {
      "type": "string", "minLength": 1, "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "nullableTimestamp": {
      "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
    },
    "nullableSha256": {
      "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "dataStatus": { "enum": ["COMPLETE", "DEGRADED_OPTIONAL"] },
    "freshness": { "enum": ["FRESH", "STALE_RETAINED"] },
    "trendStage": {
      "enum": ["UP_BUILDING", "UP_ACTIVE", "UP_COOLING", "NEUTRAL", "DOWN_BUILDING", "DOWN_ACTIVE", "DOWN_COOLING"]
    },
    "recommendation": {
      "enum": ["IGNORE", "WATCH", "RECOMMENDED_CANDIDATE", "STRONG_CANDIDATE", "OVERHEATED_DO_NOT_CHASE", "COOLING_REMOVE_FROM_PRIORITY", "WITHHELD_DATA_INCOMPLETE"]
    },
    "caseStatus": {
      "type": ["string", "null"],
      "enum": ["ACTIVE", "SUSPENDED", "RESOLVED", "UNRESOLVED", "RETRACTED", null]
    },
    "evidenceFlags": {
      "type": "array", "uniqueItems": true,
      "items": {
        "enum": ["DEMAND_ACCELERATING", "SUPPLY_CONTRACTING", "PRICE_RISING", "SUSPECTED_SWEEPING", "SWEEPING_CONFIRMED", "REACCELERATION", "OVERHEATED", "SHOCK", "BREADTH_COLLAPSE", "LIQUIDITY_CONTRACTION", "CONCENTRATION_WARNING"]
      }
    },
    "catalogDescriptor": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot_id", "catalog_version", "as_of", "available_at", "member_count", "member_set_hash"],
      "properties": {
        "snapshot_id": { "$ref": "#/$defs/sha256" },
        "catalog_version": { "$ref": "#/$defs/identifier" },
        "as_of": { "$ref": "#/$defs/timestamp" },
        "available_at": { "$ref": "#/$defs/timestamp" },
        "member_count": { "type": "integer", "minimum": 0 },
        "member_set_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "producerRelease": {
      "type": "object", "additionalProperties": false,
      "required": ["release_code", "algorithm_version", "parameter_set_version", "data_quality_policy_version"],
      "properties": {
        "release_code": { "$ref": "#/$defs/identifier" },
        "algorithm_version": { "$ref": "#/$defs/identifier" },
        "parameter_set_version": { "$ref": "#/$defs/identifier" },
        "data_quality_policy_version": { "$ref": "#/$defs/identifier" }
      }
    },
    "publication": {
      "type": "object", "additionalProperties": false,
      "required": ["publication_id", "manifest_hash", "result_as_of", "input_available_at", "public_available_at", "published_at", "fresh_until", "retain_until", "freshness", "supersedes_publication_id", "producer_release", "watchlist_policy_code", "catalog"],
      "properties": {
        "publication_id": { "$ref": "#/$defs/sha256" },
        "manifest_hash": { "$ref": "#/$defs/sha256" },
        "result_as_of": { "$ref": "#/$defs/timestamp" },
        "input_available_at": { "$ref": "#/$defs/timestamp" },
        "public_available_at": { "$ref": "#/$defs/timestamp" },
        "published_at": { "$ref": "#/$defs/timestamp" },
        "fresh_until": { "$ref": "#/$defs/timestamp" },
        "retain_until": { "$ref": "#/$defs/timestamp" },
        "freshness": { "$ref": "#/$defs/freshness" },
        "supersedes_publication_id": { "$ref": "#/$defs/nullableSha256" },
        "producer_release": { "$ref": "#/$defs/producerRelease" },
        "watchlist_policy_code": { "$ref": "#/$defs/identifier" },
        "catalog": { "$ref": "#/$defs/catalogDescriptor" }
      }
    },
    "queryBound": {
      "type": "object", "additionalProperties": false,
      "required": ["as_of", "query_known_at"],
      "properties": {
        "as_of": { "$ref": "#/$defs/nullableTimestamp" },
        "query_known_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "marketState": {
      "type": "object", "additionalProperties": false,
      "required": ["analysis_unit_id", "data_status", "trend_stage", "level_regime", "evidence_flags", "recommendation", "case_status"],
      "properties": {
        "analysis_unit_id": { "$ref": "#/$defs/identifier" },
        "data_status": { "$ref": "#/$defs/dataStatus" },
        "trend_stage": { "$ref": "#/$defs/trendStage" },
        "level_regime": { "enum": ["DEPRESSED", "NORMAL", "ELEVATED", "UNKNOWN"] },
        "evidence_flags": { "$ref": "#/$defs/evidenceFlags" },
        "recommendation": { "$ref": "#/$defs/recommendation" },
        "case_status": { "$ref": "#/$defs/caseStatus" }
      }
    },
    "breadth": {
      "type": "object", "additionalProperties": false,
      "required": ["advancing_member_ratio", "median_member_return", "breadth_expanding", "breadth_narrowing", "concentration_warning"],
      "properties": {
        "advancing_member_ratio": { "type": ["string", "null"], "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$" },
        "median_member_return": { "type": ["string", "null"], "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$" },
        "breadth_expanding": { "type": "boolean" },
        "breadth_narrowing": { "type": "boolean" },
        "concentration_warning": { "type": "boolean" }
      }
    },
    "sectorState": {
      "type": "object", "additionalProperties": false,
      "required": ["display_order", "sector_code", "analysis_unit_id", "data_status", "trend_stage", "relative_strength", "breadth", "evidence_flags", "recommendation", "case_status"],
      "properties": {
        "display_order": { "type": "integer", "minimum": 1, "maximum": 3 },
        "sector_code": { "enum": ["GLOVE", "KNIFE", "WEAPON"] },
        "analysis_unit_id": { "$ref": "#/$defs/identifier" },
        "data_status": { "$ref": "#/$defs/dataStatus" },
        "trend_stage": { "$ref": "#/$defs/trendStage" },
        "relative_strength": { "enum": ["LEADING", "IN_LINE", "LAGGING", "UNKNOWN"] },
        "breadth": { "$ref": "#/$defs/breadth" },
        "evidence_flags": { "$ref": "#/$defs/evidenceFlags" },
        "recommendation": { "$ref": "#/$defs/recommendation" },
        "case_status": { "$ref": "#/$defs/caseStatus" }
      }
    },
    "recommendationDetail": {
      "type": "object", "additionalProperties": false,
      "required": ["recommendation", "signal_strength", "evidence_coverage", "trade_confirmation"],
      "properties": {
        "recommendation": { "$ref": "#/$defs/recommendation" },
        "signal_strength": { "enum": ["NONE", "WEAK", "MODERATE", "STRONG"] },
        "evidence_coverage": { "type": "string", "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$" },
        "trade_confirmation": { "enum": ["UNAVAILABLE", "AVAILABLE_NOT_CONFIRMED", "CONFIRMED"] }
      }
    },
    "evidenceDomain": {
      "type": "object", "additionalProperties": false,
      "required": ["domain", "strength", "contributing_feature_keys", "missing_reason"],
      "properties": {
        "domain": { "enum": ["P", "D", "S"] },
        "strength": { "enum": ["UNAVAILABLE", "CONFLICTED", "ABSENT", "WEAK", "MODERATE", "STRONG"] },
        "contributing_feature_keys": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/identifier" } },
        "missing_reason": {
          "type": ["string", "null"],
          "enum": ["UNAVAILABLE_BY_DESIGN", "OPTIONAL_DATA_UNAVAILABLE", "DATA_UNAVAILABLE_RUNTIME_GRACE", "DATA_UNAVAILABLE_RUNTIME", "STALE_GRACE", "STALE", "CONFLICTED_INPUTS", null]
        }
      }
    },
    "itemState": {
      "type": "object", "additionalProperties": false,
      "required": ["analysis_unit_id", "data_status", "cycle_stage", "evidence_flags", "regime_relation", "recommendation", "case_status", "recommendation_detail", "evidence_domains", "claims"],
      "properties": {
        "analysis_unit_id": { "$ref": "#/$defs/identifier" },
        "data_status": { "$ref": "#/$defs/dataStatus" },
        "cycle_stage": { "enum": ["BASELINE", "PRESSURE_BUILDING", "CONFIRMED_UP", "COOLING"] },
        "evidence_flags": { "$ref": "#/$defs/evidenceFlags" },
        "regime_relation": { "type": "array", "uniqueItems": true, "items": { "enum": ["MARKET_DRIVEN", "SECTOR_DRIVEN", "ITEM_SPECIFIC", "COUNTER_REGIME", "IN_LINE", "UNKNOWN"] } },
        "recommendation": { "$ref": "#/$defs/recommendation" },
        "case_status": { "$ref": "#/$defs/caseStatus" },
        "recommendation_detail": { "$ref": "#/$defs/recommendationDetail" },
        "evidence_domains": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/evidenceDomain" } },
        "claims": { "type": "array", "uniqueItems": true, "items": { "enum": ["UNIFIED_PRICE_RISING", "BID_PRICE_RISING", "BUY_DEMAND_STRENGTHENING", "SELLABLE_SUPPLY_DECLINING", "MULTI_SOURCE_ALIGNED", "TRUSTED_TRADE_VOLUME_INCREASING", "SWEEPING_CONFIRMED"] } }
      }
    },
    "catalogLocalizedName": {
      "type": "object", "additionalProperties": false,
      "required": ["en", "zh_cn"],
      "properties": {
        "en": {
          "type": "string", "minLength": 1, "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "zh_cn": {
          "type": "string", "minLength": 1, "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        }
      }
    },
    "versionId": {
      "type": "string", "pattern": "^[1-9][0-9]*$"
    },
    "catalogMediaNotProduced": {
      "type": "object", "additionalProperties": false,
      "required": ["status"],
      "properties": { "status": { "const": "NOT_PRODUCED" } }
    },
    "catalogMediaBound": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "media_asset_version_id", "media_key", "presentation_kind"],
      "properties": {
        "status": { "const": "BOUND" },
        "media_asset_version_id": { "$ref": "#/$defs/versionId" },
        "media_key": {
          "type": "string", "maxLength": 256,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9._-])?(?:/[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9._-])?)*$",
          "not": { "pattern": "(^|/)\\.{1,2}(/|$)" }
        },
        "presentation_kind": {
          "enum": ["SERIES_REPRESENTATIVE", "STYLE_REPRESENTATIVE"]
        }
      }
    },
    "catalogMedia": {
      "oneOf": [
        { "$ref": "#/$defs/catalogMediaNotProduced" },
        { "$ref": "#/$defs/catalogMediaBound" }
      ]
    },
    "catalogProjection": {
      "type": "object", "additionalProperties": false,
      "required": [
        "analysis_unit_id", "parent_analysis_unit_id", "analysis_unit_kind",
        "item_kind", "base_item_code", "edition_kind", "wear_tier",
        "localized_name", "media", "catalog_version"
      ],
      "properties": {
        "analysis_unit_id": { "$ref": "#/$defs/identifier" },
        "parent_analysis_unit_id": {
          "oneOf": [{ "$ref": "#/$defs/identifier" }, { "type": "null" }]
        },
        "analysis_unit_kind": {
          "enum": ["BASE_MHN", "STYLE_VARIANT", "PATTERN_VARIANT"]
        },
        "item_kind": {
          "enum": ["WEAPON", "KNIFE", "GLOVE", "AGENT", "OTHER", "UNKNOWN"]
        },
        "base_item_code": { "$ref": "#/$defs/identifier" },
        "edition_kind": {
          "enum": ["STANDARD", "STATTRAK", "SOUVENIR", "UNKNOWN"]
        },
        "wear_tier": {
          "enum": [
            "FACTORY_NEW", "MINIMAL_WEAR", "FIELD_TESTED", "WELL_WORN",
            "BATTLE_SCARRED", "NOT_APPLICABLE", "UNKNOWN"
          ]
        },
        "localized_name": { "$ref": "#/$defs/catalogLocalizedName" },
        "media": { "$ref": "#/$defs/catalogMedia" },
        "catalog_version": {
          "type": "string", "minLength": 1, "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        }
      }
    },
    "watchlistMember": {
      "type": "object", "additionalProperties": false,
      "required": ["rank", "tie_break_key", "inclusion_reason_codes", "result", "catalog"],
      "properties": {
        "rank": { "type": "integer", "minimum": 1, "maximum": 500 },
        "tie_break_key": { "$ref": "#/$defs/identifier" },
        "inclusion_reason_codes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" } },
        "result": { "$ref": "#/$defs/itemState" },
        "catalog": { "$ref": "#/$defs/catalogProjection" }
      }
    },
    "marketPublicationSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["publication", "market", "sectors"],
      "properties": {
        "publication": { "$ref": "#/$defs/publication" },
        "market": { "$ref": "#/$defs/marketState" },
        "sectors": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "prefixItems": [
            { "allOf": [{ "$ref": "#/$defs/sectorState" }, { "properties": { "display_order": { "const": 1 }, "sector_code": { "const": "GLOVE" } } }] },
            { "allOf": [{ "$ref": "#/$defs/sectorState" }, { "properties": { "display_order": { "const": 2 }, "sector_code": { "const": "KNIFE" } } }] },
            { "allOf": [{ "$ref": "#/$defs/sectorState" }, { "properties": { "display_order": { "const": 3 }, "sector_code": { "const": "WEAPON" } } }] }
          ],
          "items": false
        }
      }
    },
    "marketOverviewResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["api_contract", "api_version", "response_kind", "query", "publication", "market", "sectors"],
      "properties": {
        "api_contract": { "const": "market-watchlist-public-api" }, "api_version": { "const": "v1" },
        "response_kind": { "const": "MARKET_OVERVIEW" }, "query": { "$ref": "#/$defs/queryBound" },
        "publication": { "$ref": "#/$defs/publication" }, "market": { "$ref": "#/$defs/marketState" },
        "sectors": { "$ref": "#/$defs/marketPublicationSummary/properties/sectors" }
      }
    },
    "marketHistoryQuery": {
      "type": "object", "additionalProperties": false,
      "required": ["as_of", "query_known_at", "page_size", "cursor"],
      "properties": {
        "as_of": { "$ref": "#/$defs/nullableTimestamp" }, "query_known_at": { "$ref": "#/$defs/timestamp" },
        "page_size": { "type": "integer", "minimum": 1, "maximum": 32 },
        "cursor": { "type": ["string", "null"], "maxLength": 8192, "pattern": "^[A-Za-z0-9_-]+$" }
      }
    },
    "marketHistoryResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["api_contract", "api_version", "response_kind", "query", "members", "next_cursor"],
      "properties": {
        "api_contract": { "const": "market-watchlist-public-api" }, "api_version": { "const": "v1" },
        "response_kind": { "const": "MARKET_HISTORY" }, "query": { "$ref": "#/$defs/marketHistoryQuery" },
        "members": { "type": "array", "items": { "$ref": "#/$defs/marketPublicationSummary" } },
        "next_cursor": { "type": ["string", "null"], "maxLength": 8192, "pattern": "^[A-Za-z0-9_-]+$" }
      }
    },
    "watchlistQuery": {
      "type": "object", "additionalProperties": false,
      "required": ["as_of", "query_known_at", "publication_id", "sort", "page_size", "cursor"],
      "properties": {
        "as_of": { "$ref": "#/$defs/nullableTimestamp" }, "query_known_at": { "$ref": "#/$defs/timestamp" },
        "publication_id": { "$ref": "#/$defs/nullableSha256" }, "sort": { "const": "RANK_ASC" },
        "page_size": { "type": "integer", "minimum": 1, "maximum": 100 },
        "cursor": { "type": ["string", "null"], "maxLength": 8192, "pattern": "^[A-Za-z0-9_-]+$" }
      }
    },
    "watchlistResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["api_contract", "api_version", "response_kind", "query", "publication", "total", "members", "next_cursor"],
      "properties": {
        "api_contract": { "const": "market-watchlist-public-api" }, "api_version": { "const": "v1" },
        "response_kind": { "const": "WATCHLIST" }, "query": { "$ref": "#/$defs/watchlistQuery" },
        "publication": { "$ref": "#/$defs/publication" }, "total": { "type": "integer", "minimum": 0, "maximum": 500 },
        "members": { "type": "array", "items": { "$ref": "#/$defs/watchlistMember" } },
        "next_cursor": { "type": ["string", "null"], "maxLength": 8192, "pattern": "^[A-Za-z0-9_-]+$" }
      }
    },
    "detailQuery": {
      "type": "object", "additionalProperties": false,
      "required": ["as_of", "query_known_at", "publication_id", "analysis_unit_id"],
      "properties": {
        "as_of": { "$ref": "#/$defs/nullableTimestamp" }, "query_known_at": { "$ref": "#/$defs/timestamp" },
        "publication_id": { "$ref": "#/$defs/sha256" }, "analysis_unit_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "watchlistDetailResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["api_contract", "api_version", "response_kind", "query", "publication", "member"],
      "properties": {
        "api_contract": { "const": "market-watchlist-public-api" }, "api_version": { "const": "v1" },
        "response_kind": { "const": "WATCHLIST_DETAIL" }, "query": { "$ref": "#/$defs/detailQuery" },
        "publication": { "$ref": "#/$defs/publication" }, "member": { "$ref": "#/$defs/watchlistMember" }
      }
    },
    "watchlistHistoryMember": {
      "type": "object", "additionalProperties": false,
      "required": ["publication", "rank", "inclusion_reason_codes", "result"],
      "properties": {
        "publication": { "$ref": "#/$defs/publication" }, "rank": { "type": "integer", "minimum": 1, "maximum": 500 },
        "inclusion_reason_codes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" } },
        "result": { "$ref": "#/$defs/itemState" }
      }
    },
    "watchlistHistoryQuery": {
      "type": "object", "additionalProperties": false,
      "required": ["query_known_at", "publication_id", "analysis_unit_id", "page_size", "cursor"],
      "properties": {
        "query_known_at": { "$ref": "#/$defs/timestamp" },
        "publication_id": { "$ref": "#/$defs/sha256" },
        "analysis_unit_id": { "$ref": "#/$defs/identifier" },
        "page_size": { "type": "integer", "minimum": 1, "maximum": 50 },
        "cursor": { "type": ["string", "null"], "maxLength": 8192, "pattern": "^[A-Za-z0-9_-]+$" }
      }
    },
    "watchlistHistoryResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["api_contract", "api_version", "response_kind", "query", "members", "next_cursor"],
      "properties": {
        "api_contract": { "const": "market-watchlist-public-api" }, "api_version": { "const": "v1" },
        "response_kind": { "const": "WATCHLIST_HISTORY" }, "query": { "$ref": "#/$defs/watchlistHistoryQuery" },
        "members": { "type": "array", "items": { "$ref": "#/$defs/watchlistHistoryMember" } },
        "next_cursor": { "type": ["string", "null"], "maxLength": 8192, "pattern": "^[A-Za-z0-9_-]+$" }
      }
    },
    "errorResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["api_contract", "api_version", "response_kind", "error"],
      "properties": {
        "api_contract": { "const": "market-watchlist-public-api" }, "api_version": { "const": "v1" },
        "response_kind": { "const": "ERROR" },
        "error": {
          "type": "object", "additionalProperties": false, "required": ["code", "retryable"],
          "properties": {
            "code": { "enum": ["INVALID_ARGUMENT", "INVALID_CURSOR", "NOT_PUBLISHED", "NOT_FOUND", "BACKEND_UNAVAILABLE", "PUBLICATION_EXPIRED", "PUBLICATION_WITHDRAWN", "RESULT_CORRUPT"] },
            "retryable": { "type": "boolean" }
          }
        }
      }
    }
  }
}
