{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cs2.example.invalid/schemas/valve-event-public-api-v1.schema.json",
  "title": "Valve Event Public Read API V1",
  "oneOf": [
    {
      "$ref": "#/$defs/listResponse"
    },
    {
      "$ref": "#/$defs/detailResponse"
    }
  ],
  "$defs": {
    "nonblank": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "status": {
      "enum": [
        "SOURCE_ONLY",
        "ANALYSIS_PENDING",
        "ANALYSIS_BLOCKED",
        "PUBLIC",
        "SOURCE_UPDATED_ANALYSIS_PENDING",
        "CORRECTED",
        "WITHDRAWN"
      ]
    },
    "temporalMode": {
      "enum": [
        "PROSPECTIVE",
        "RETROSPECTIVE_REPLAY",
        "RETROSPECTIVE_WITH_HINDSIGHT",
        "RETROSPECTIVE_CORRECTION"
      ]
    },
    "direction": {
      "enum": [
        "POSITIVE",
        "NEGATIVE",
        "MIXED",
        "NO_CLEAR_IMPACT",
        "UNCERTAIN"
      ]
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "corrected",
        "source_updated",
        "withdrawn"
      ],
      "properties": {
        "corrected": {
          "type": "boolean"
        },
        "source_updated": {
          "type": "boolean"
        },
        "withdrawn": {
          "type": "boolean"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "first_observed_at",
        "official_published_at",
        "official_title",
        "official_url",
        "source_code",
        "source_notice_version_id",
        "source_updated_at"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/nonblank"
        },
        "first_observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "official_published_at": {
          "$ref": "#/$defs/timestamp"
        },
        "official_title": {
          "$ref": "#/$defs/nonblank"
        },
        "official_url": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        },
        "source_code": {
          "const": "STEAM_ISteamNews_V2"
        },
        "source_notice_version_id": {
          "$ref": "#/$defs/nonblank"
        },
        "source_updated_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "article": {
      "oneOf": [
        {
          "$ref": "#/$defs/sectionedArticle"
        },
        {
          "$ref": "#/$defs/bilingualReaderArticle"
        }
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "direction",
        "falsification_conditions",
        "horizon",
        "limitations",
        "mechanism_codes",
        "observation_targets",
        "reasoning_section_ref",
        "scope_display",
        "scope_kind",
        "scope_ref",
        "tracking_status"
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/nonblank"
        },
        "direction": {
          "$ref": "#/$defs/direction"
        },
        "falsification_conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonblank"
          }
        },
        "horizon": {
          "enum": [
            "IMMEDIATE",
            "SHORT_TERM",
            "STRUCTURAL",
            "UNSPECIFIED"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonblank"
          }
        },
        "mechanism_codes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonblank"
          }
        },
        "observation_targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonblank"
          }
        },
        "reasoning_section_ref": {
          "$ref": "#/$defs/nonblank"
        },
        "scope_display": {
          "$ref": "#/$defs/nonblank"
        },
        "scope_kind": {
          "enum": [
            "MARKET",
            "SECTOR",
            "ASSET_FAMILY",
            "ITEM",
            "MECHANISM"
          ]
        },
        "scope_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "tracking_status": {
          "enum": [
            "TRACKED",
            "UNTRACKED_SUBJECT",
            "UNRESOLVED"
          ]
        }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "article",
        "claims",
        "context_snapshot_id",
        "context_status",
        "correction_of_publication_id",
        "disclosures",
        "event_cutoff_at",
        "known_at",
        "public_payload_sha256",
        "publication_id",
        "publication_version_no",
        "published_at",
        "source_notice_version_id",
        "temporal_mode"
      ],
      "properties": {
        "article": {
          "$ref": "#/$defs/article"
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "context_snapshot_id": {
          "$ref": "#/$defs/nonblank"
        },
        "context_status": {
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "UNAVAILABLE",
            "TEMPORAL_VIOLATION",
            "CONTRACT_MISMATCH"
          ]
        },
        "correction_of_publication_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "disclosures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/nonblank"
          }
        },
        "event_cutoff_at": {
          "$ref": "#/$defs/timestamp"
        },
        "known_at": {
          "$ref": "#/$defs/timestamp"
        },
        "public_payload_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "publication_id": {
          "$ref": "#/$defs/nonblank"
        },
        "publication_version_no": {
          "type": "integer",
          "minimum": 1
        },
        "published_at": {
          "$ref": "#/$defs/timestamp"
        },
        "source_notice_version_id": {
          "$ref": "#/$defs/nonblank"
        },
        "temporal_mode": {
          "$ref": "#/$defs/temporalMode"
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_status",
        "explanation",
        "label",
        "noise_and_causality_disclosure",
        "observation_cutoff_at",
        "outcome_evaluation_id",
        "outcome_publication_id",
        "policy_release_id",
        "published_at"
      ],
      "properties": {
        "evidence_status": {
          "$ref": "#/$defs/nonblank"
        },
        "explanation": {
          "$ref": "#/$defs/nonblank"
        },
        "label": {
          "enum": [
            "SUPPORTED",
            "MIXED",
            "NOT_SUPPORTED",
            "UNAVAILABLE"
          ]
        },
        "noise_and_causality_disclosure": {
          "$ref": "#/$defs/nonblank"
        },
        "observation_cutoff_at": {
          "$ref": "#/$defs/timestamp"
        },
        "outcome_evaluation_id": {
          "$ref": "#/$defs/nonblank"
        },
        "outcome_publication_id": {
          "$ref": "#/$defs/nonblank"
        },
        "policy_release_id": {
          "$ref": "#/$defs/nonblank"
        },
        "published_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication_id",
        "publication_version_no",
        "published_at",
        "temporal_mode",
        "withdrawal_reason",
        "withdrawn"
      ],
      "properties": {
        "publication_id": {
          "$ref": "#/$defs/nonblank"
        },
        "publication_version_no": {
          "type": "integer",
          "minimum": 1
        },
        "published_at": {
          "$ref": "#/$defs/timestamp"
        },
        "temporal_mode": {
          "$ref": "#/$defs/temporalMode"
        },
        "withdrawal_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "withdrawn": {
          "type": "boolean"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conclusion_summary",
        "flags",
        "outcome_label",
        "primary_direction",
        "scope_labels",
        "source",
        "status",
        "temporal_mode"
      ],
      "properties": {
        "conclusion_summary": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "$ref": "#/$defs/localizedSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "flags": {
          "$ref": "#/$defs/flags"
        },
        "outcome_label": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "SUPPORTED",
            "MIXED",
            "NOT_SUPPORTED",
            "UNAVAILABLE",
            null
          ]
        },
        "primary_direction": {
          "oneOf": [
            {
              "$ref": "#/$defs/direction"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope_labels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonblank"
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "temporal_mode": {
          "oneOf": [
            {
              "$ref": "#/$defs/temporalMode"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flags",
        "latest_outcome",
        "latest_publication",
        "public_versions",
        "source",
        "status"
      ],
      "properties": {
        "flags": {
          "$ref": "#/$defs/flags"
        },
        "latest_outcome": {
          "oneOf": [
            {
              "$ref": "#/$defs/outcome"
            },
            {
              "type": "null"
            }
          ]
        },
        "latest_publication": {
          "oneOf": [
            {
              "$ref": "#/$defs/assessment"
            },
            {
              "type": "null"
            }
          ]
        },
        "public_versions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/version"
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      }
    },
    "listResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_contract",
        "api_version",
        "events",
        "next_cursor",
        "query_hash",
        "response_kind"
      ],
      "properties": {
        "api_contract": {
          "const": "valve-event-public-api"
        },
        "api_version": {
          "const": "v1"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/summary"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "query_hash": {
          "$ref": "#/$defs/sha256"
        },
        "response_kind": {
          "const": "VALVE_EVENT_LIST"
        }
      }
    },
    "detailResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_contract",
        "api_version",
        "etag",
        "event",
        "response_kind"
      ],
      "properties": {
        "api_contract": {
          "const": "valve-event-public-api"
        },
        "api_version": {
          "const": "v1"
        },
        "etag": {
          "$ref": "#/$defs/sha256"
        },
        "event": {
          "$ref": "#/$defs/event"
        },
        "response_kind": {
          "const": "VALVE_EVENT_DETAIL"
        }
      }
    },
    "sectionedArticle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conclusion",
        "factual_summary",
        "observation_and_falsification",
        "scope_analysis",
        "title",
        "transmission_mechanisms",
        "uncertainties_and_counterforces"
      ],
      "properties": {
        "conclusion": {
          "$ref": "#/$defs/nonblank"
        },
        "factual_summary": {
          "$ref": "#/$defs/nonblank"
        },
        "observation_and_falsification": {
          "$ref": "#/$defs/nonblank"
        },
        "scope_analysis": {
          "$ref": "#/$defs/nonblank"
        },
        "title": {
          "$ref": "#/$defs/nonblank"
        },
        "transmission_mechanisms": {
          "$ref": "#/$defs/nonblank"
        },
        "uncertainties_and_counterforces": {
          "$ref": "#/$defs/nonblank"
        }
      }
    },
    "localizedReaderMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "body"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/nonblank"
        },
        "body": {
          "$ref": "#/$defs/nonblank"
        }
      }
    },
    "bilingualReaderArticle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zh_cn",
        "en"
      ],
      "properties": {
        "zh_cn": {
          "$ref": "#/$defs/localizedReaderMember"
        },
        "en": {
          "$ref": "#/$defs/localizedReaderMember"
        }
      }
    },
    "localizedSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zh_cn",
        "en"
      ],
      "properties": {
        "zh_cn": {
          "$ref": "#/$defs/nonblank"
        },
        "en": {
          "$ref": "#/$defs/nonblank"
        }
      }
    }
  }
}
