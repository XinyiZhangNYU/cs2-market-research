{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cs2-research:price-display-api:v1",
  "title": "Immutable native and bicurrency price display API V1",
  "oneOf": [
    { "$ref": "#/$defs/snapshotListResponse" },
    { "$ref": "#/$defs/itemResponse" },
    { "$ref": "#/$defs/historyResponse" },
    { "$ref": "#/$defs/errorResponse" }
  ],
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z(?![\\s\\S])"
    },
    "date": { "type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])" },
    "identifier": {
      "type": "string", "minLength": 1, "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f\\ud800-\\udfff]+(?![\\s\\S])"
    },
    "itemId": { "type": "string", "pattern": "^[1-9][0-9]{0,18}(?![\\s\\S])" },
    "usdValue": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,29})\\.[0-9]{8}(?![\\s\\S])" },
    "cnyValue": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,16})\\.[0-9]{2}(?![\\s\\S])" },
    "minorValue": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,18})(?![\\s\\S])" },
    "rateValue": {
      "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,19})\\.[0-9]{18}(?![\\s\\S])",
      "not": { "const": "0.000000000000000000" }
    },
    "currency": { "enum": ["USD", "CNY"] },
    "sourceReason": { "enum": ["SOURCE_UNAVAILABLE", "CAPTURE_GAP", "SOURCE_CONFLICT"] },
    "amountReason": { "enum": ["SOURCE_UNAVAILABLE", "CAPTURE_GAP", "SOURCE_CONFLICT", "NO_ELIGIBLE_FX", "FX_STALE", "AMOUNT_OUT_OF_RANGE"] },
    "sourcePrice": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "currency", "unit", "normalized_fraction_digits", "upstream_fraction_digits"],
      "properties": {
        "value": { "type": "string", "minLength": 1, "maxLength": 39 },
        "currency": { "$ref": "#/$defs/currency" },
        "unit": { "enum": ["USD_DECIMAL", "CNY_MINOR"] },
        "normalized_fraction_digits": { "type": "integer", "enum": [0, 8] },
        "upstream_fraction_digits": {
          "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 9007199254740991 }, { "type": "null" }]
        }
      },
      "allOf": [
        { "if": { "properties": { "unit": { "const": "USD_DECIMAL" } }, "required": ["unit"] },
          "then": { "properties": { "value": { "$ref": "#/$defs/usdValue" }, "currency": { "const": "USD" }, "normalized_fraction_digits": { "const": 8 } } } },
        { "if": { "properties": { "unit": { "const": "CNY_MINOR" } }, "required": ["unit"] },
          "then": { "properties": { "value": { "$ref": "#/$defs/minorValue" }, "currency": { "const": "CNY" }, "normalized_fraction_digits": { "const": 0 } } } }
      ]
    },
    "availableAmount": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "currency", "amount", "scale", "basis", "rounding", "reason"],
      "properties": {
        "status": { "const": "AVAILABLE" }, "currency": { "$ref": "#/$defs/currency" },
        "amount": { "type": "string" }, "scale": { "type": "integer", "enum": [2, 8] },
        "basis": { "enum": ["NATIVE", "FX_DERIVED"] },
        "rounding": { "enum": ["EXACT", "ROUNDED", "ROUNDED_TO_ZERO"] }, "reason": { "type": "null" }
      },
      "allOf": [
        { "if": { "properties": { "currency": { "const": "USD" } }, "required": ["currency"] },
          "then": { "properties": { "amount": { "$ref": "#/$defs/usdValue" }, "scale": { "const": 8 } } } },
        { "if": { "properties": { "currency": { "const": "CNY" } }, "required": ["currency"] },
          "then": { "properties": { "amount": { "$ref": "#/$defs/cnyValue" }, "scale": { "const": 2 } } } },
        { "if": { "properties": { "basis": { "const": "NATIVE" } }, "required": ["basis"] },
          "then": { "properties": { "rounding": { "const": "EXACT" } } } },
        { "if": { "properties": { "rounding": { "const": "ROUNDED_TO_ZERO" } }, "required": ["rounding"] },
          "then": { "properties": { "amount": { "enum": ["0.00", "0.00000000"] } } } }
      ]
    },
    "unavailableAmount": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "currency", "amount", "scale", "basis", "rounding", "reason"],
      "properties": {
        "status": { "const": "UNAVAILABLE" }, "currency": { "$ref": "#/$defs/currency" },
        "amount": { "type": "null" }, "scale": { "type": "null" }, "basis": { "type": "null" },
        "rounding": { "type": "null" }, "reason": { "$ref": "#/$defs/amountReason" }
      }
    },
    "amount": { "oneOf": [{ "$ref": "#/$defs/availableAmount" }, { "$ref": "#/$defs/unavailableAmount" }] },
    "amounts": {
      "type": "object", "additionalProperties": false, "required": ["USD", "CNY"],
      "properties": {
        "USD": { "allOf": [{ "$ref": "#/$defs/amount" }, { "properties": { "currency": { "const": "USD" } } }] },
        "CNY": { "allOf": [{ "$ref": "#/$defs/amount" }, { "properties": { "currency": { "const": "CNY" } } }] }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["quote_origin", "logical_market", "transport"],
      "properties": {
        "quote_origin": { "enum": ["SOURCE_QUOTE", "PROVIDER_AGGREGATE"] },
        "logical_market": { "enum": ["market_a", "market_c", "market_b", null] },
        "transport": { "enum": ["upstream", "market_b_direct"] }
      },
      "allOf": [
        { "if": { "properties": { "quote_origin": { "const": "PROVIDER_AGGREGATE" } }, "required": ["quote_origin"] },
          "then": { "properties": { "logical_market": { "type": "null" }, "transport": { "const": "upstream" } } },
          "else": { "properties": { "logical_market": { "enum": ["market_a", "market_c", "market_b"] } } } },
        { "if": { "properties": { "transport": { "const": "market_b_direct" } }, "required": ["transport"] },
          "then": { "properties": { "quote_origin": { "const": "SOURCE_QUOTE" }, "logical_market": { "const": "market_b" } } } }
      ]
    },
    "fx": {
      "type": "object", "additionalProperties": false,
      "required": ["public_rate_id", "authority", "method", "source_event_date", "cny_per_usd", "carry_days", "available_at", "cny_valid_from", "usd_valid_from", "fx_selection_policy_version", "conversion_policy_version", "usage"],
      "properties": {
        "public_rate_id": { "$ref": "#/$defs/sha256" }, "authority": { "const": "ECB" },
        "method": { "const": "ECB_EUR_CROSS" }, "source_event_date": { "$ref": "#/$defs/date" },
        "cny_per_usd": { "$ref": "#/$defs/rateValue" }, "carry_days": { "type": "integer", "minimum": 0, "maximum": 7 },
        "available_at": { "$ref": "#/$defs/timestamp" }, "cny_valid_from": { "$ref": "#/$defs/timestamp" },
        "usd_valid_from": { "$ref": "#/$defs/timestamp" }, "fx_selection_policy_version": { "const": "ecb-eur-cross-daily/2" },
        "conversion_policy_version": { "enum": ["price-display-bicurrency/1", "ecb-eur-cross-daily/2"] },
        "usage": { "const": "PRICE_DISPLAY_ONLY" }
      }
    },
    "nullableTimestamp": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
    "quote": {
      "type": "object", "additionalProperties": false,
      "required": ["quote_id", "analysis_unit_id", "item_id", "quote_kind", "source", "bucket_at", "observed_at", "time_basis", "source_updated_at", "source_collected_at", "source_available_at", "identity_available_at", "identity_policy", "late_bound", "source_price", "source_price_reason", "amounts", "fx", "available_at"],
      "properties": {
        "quote_id": { "$ref": "#/$defs/sha256" }, "analysis_unit_id": { "$ref": "#/$defs/identifier" },
        "item_id": { "$ref": "#/$defs/itemId" }, "quote_kind": { "enum": ["ASK", "BID"] },
        "source": { "$ref": "#/$defs/source" }, "bucket_at": { "$ref": "#/$defs/nullableTimestamp" },
        "observed_at": { "$ref": "#/$defs/nullableTimestamp" }, "time_basis": { "enum": ["BUCKET_AT", "OBSERVED_AT", "UNAVAILABLE"] },
        "source_updated_at": { "$ref": "#/$defs/nullableTimestamp" }, "source_collected_at": { "$ref": "#/$defs/nullableTimestamp" },
        "source_available_at": { "$ref": "#/$defs/timestamp" }, "identity_available_at": { "$ref": "#/$defs/timestamp" },
        "identity_policy": { "enum": ["CATALOG_SNAPSHOT_EXACT_ITEM_V1", "CURRENT_EXACT_MHN_LATE_BIND_V1"] },
        "late_bound": { "type": "boolean" }, "source_price": { "oneOf": [{ "$ref": "#/$defs/sourcePrice" }, { "type": "null" }] },
        "source_price_reason": { "oneOf": [{ "$ref": "#/$defs/sourceReason" }, { "type": "null" }] },
        "amounts": { "$ref": "#/$defs/amounts" }, "fx": { "oneOf": [{ "$ref": "#/$defs/fx" }, { "type": "null" }] },
        "available_at": { "$ref": "#/$defs/timestamp" }
      },
      "allOf": [
        { "if": { "properties": { "source_price": { "type": "null" } }, "required": ["source_price"] },
          "then": { "properties": {
            "source_price_reason": { "$ref": "#/$defs/sourceReason" }, "fx": { "type": "null" },
            "amounts": { "properties": { "USD": { "$ref": "#/$defs/unavailableAmount" }, "CNY": { "$ref": "#/$defs/unavailableAmount" } } }
          } }, "else": { "properties": { "source_price_reason": { "type": "null" } } } },
        { "if": { "properties": { "time_basis": { "const": "BUCKET_AT" } }, "required": ["time_basis"] },
          "then": { "properties": { "bucket_at": { "$ref": "#/$defs/timestamp" } } } },
        { "if": { "properties": { "time_basis": { "const": "OBSERVED_AT" } }, "required": ["time_basis"] },
          "then": { "properties": { "bucket_at": { "type": "null" }, "observed_at": { "$ref": "#/$defs/timestamp" } } } },
        { "if": { "properties": { "time_basis": { "const": "UNAVAILABLE" } }, "required": ["time_basis"] },
          "then": { "properties": { "bucket_at": { "type": "null" }, "observed_at": { "type": "null" }, "fx": { "type": "null" }, "source_price": { "$ref": "#/$defs/sourcePrice" } } } },
        { "if": { "properties": { "identity_policy": { "const": "CURRENT_EXACT_MHN_LATE_BIND_V1" } }, "required": ["identity_policy"] },
          "then": { "properties": { "late_bound": { "const": true } } },
          "else": { "properties": { "late_bound": { "const": false } } } }
      ]
    },
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot_id", "catalog_snapshot_id", "catalog_as_of", "catalog_available_at", "market_as_of", "available_at", "published_at", "kind", "price_policy_version"],
      "properties": {
        "snapshot_id": { "$ref": "#/$defs/sha256" }, "catalog_snapshot_id": { "$ref": "#/$defs/sha256" },
        "catalog_as_of": { "$ref": "#/$defs/timestamp" }, "catalog_available_at": { "$ref": "#/$defs/timestamp" },
        "market_as_of": { "$ref": "#/$defs/timestamp" }, "available_at": { "$ref": "#/$defs/timestamp" },
        "published_at": { "$ref": "#/$defs/timestamp" }, "kind": { "enum": ["CURRENT", "HISTORY"] },
        "price_policy_version": { "const": "price-display-read/1" }
      }
    },
    "snapshotQuery": {
      "type": "object", "additionalProperties": false,
      "required": ["query_as_of", "known_at", "catalog_snapshot_id", "kind", "page_size", "sort"],
      "properties": {
        "query_as_of": { "$ref": "#/$defs/timestamp" }, "known_at": { "$ref": "#/$defs/timestamp" },
        "catalog_snapshot_id": { "$ref": "#/$defs/sha256" }, "kind": { "enum": ["CURRENT", "HISTORY"] },
        "page_size": { "type": "integer", "minimum": 1, "maximum": 20 }, "sort": { "const": "MARKET_AS_OF_DESC" }
      }
    },
    "itemQuery": {
      "type": "object", "additionalProperties": false,
      "required": ["analysis_unit_id", "snapshot_id", "as_of", "known_at"],
      "properties": {
        "analysis_unit_id": { "$ref": "#/$defs/identifier" }, "snapshot_id": { "$ref": "#/$defs/sha256" },
        "as_of": { "$ref": "#/$defs/timestamp" }, "known_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "cursor": { "type": "string", "minLength": 1, "maxLength": 8192, "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])" },
    "historyQuery": {
      "type": "object", "additionalProperties": false,
      "required": ["analysis_unit_id", "snapshot_id", "as_of", "known_at", "from", "to", "quote_origin", "logical_market", "quote_kind", "page_size", "cursor", "sort"],
      "properties": {
        "analysis_unit_id": { "$ref": "#/$defs/identifier" }, "snapshot_id": { "$ref": "#/$defs/sha256" },
        "as_of": { "$ref": "#/$defs/timestamp" }, "known_at": { "$ref": "#/$defs/timestamp" },
        "from": { "$ref": "#/$defs/timestamp" }, "to": { "$ref": "#/$defs/timestamp" },
        "quote_origin": { "enum": ["SOURCE_QUOTE", "PROVIDER_AGGREGATE", null] },
        "logical_market": { "enum": ["market_a", "market_c", "market_b", null] }, "quote_kind": { "enum": ["ASK", "BID", null] },
        "page_size": { "type": "integer", "minimum": 1, "maximum": 200 },
        "cursor": { "oneOf": [{ "$ref": "#/$defs/cursor" }, { "type": "null" }] },
        "sort": { "const": "EVENT_SOURCE_QUOTE_ID_ASC" }
      }
    },
    "pagination": {
      "type": "object", "additionalProperties": false, "required": ["page_size", "next_cursor"],
      "properties": {
        "page_size": { "type": "integer", "minimum": 1, "maximum": 200 },
        "next_cursor": { "oneOf": [{ "$ref": "#/$defs/cursor" }, { "type": "null" }] }
      }
    },
    "snapshotListResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["api_contract", "api_version", "response_kind", "query", "snapshot", "items", "pagination", "document_hash"],
      "properties": {
        "api_contract": { "const": "price-display-api" }, "api_version": { "const": "v1" },
        "response_kind": { "const": "PRICE_SNAPSHOT_LIST" }, "query": { "$ref": "#/$defs/snapshotQuery" },
        "snapshot": { "type": "null" }, "items": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/snapshot" } },
        "pagination": { "allOf": [{ "$ref": "#/$defs/pagination" }, { "properties": { "page_size": { "maximum": 20 }, "next_cursor": { "type": "null" } } }] },
        "document_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "itemResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["api_contract", "api_version", "response_kind", "query", "snapshot", "items", "pagination", "document_hash"],
      "properties": {
        "api_contract": { "const": "price-display-api" }, "api_version": { "const": "v1" },
        "response_kind": { "const": "PRICE_ITEM" }, "query": { "$ref": "#/$defs/itemQuery" },
        "snapshot": { "allOf": [{ "$ref": "#/$defs/snapshot" }, { "properties": { "kind": { "const": "CURRENT" } } }] },
        "items": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/quote" } },
        "pagination": { "type": "null" }, "document_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "historyResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["api_contract", "api_version", "response_kind", "query", "snapshot", "items", "pagination", "document_hash"],
      "properties": {
        "api_contract": { "const": "price-display-api" }, "api_version": { "const": "v1" },
        "response_kind": { "const": "PRICE_HISTORY" }, "query": { "$ref": "#/$defs/historyQuery" },
        "snapshot": { "allOf": [{ "$ref": "#/$defs/snapshot" }, { "properties": { "kind": { "const": "HISTORY" } } }] },
        "items": { "type": "array", "maxItems": 200, "items": { "$ref": "#/$defs/quote" } },
        "pagination": { "$ref": "#/$defs/pagination" }, "document_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "error": {
      "type": "object", "additionalProperties": false, "required": ["code", "http_status", "retryable"],
      "properties": {
        "code": { "enum": ["INVALID_ARGUMENT", "INVALID_CURSOR", "NOT_FOUND", "CONTRACT_UNAVAILABLE", "RECORD_CORRUPT", "BACKEND_UNAVAILABLE"] },
        "http_status": { "type": "integer", "enum": [400, 404, 503] }, "retryable": { "type": "boolean" }
      },
      "oneOf": [
        { "properties": { "code": { "enum": ["INVALID_ARGUMENT", "INVALID_CURSOR"] }, "http_status": { "const": 400 }, "retryable": { "const": false } } },
        { "properties": { "code": { "const": "NOT_FOUND" }, "http_status": { "const": 404 }, "retryable": { "const": false } } },
        { "properties": { "code": { "const": "RECORD_CORRUPT" }, "http_status": { "const": 503 }, "retryable": { "const": false } } },
        { "properties": { "code": { "enum": ["CONTRACT_UNAVAILABLE", "BACKEND_UNAVAILABLE"] }, "http_status": { "const": 503 }, "retryable": { "const": true } } }
      ]
    },
    "errorResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["api_contract", "api_version", "response_kind", "query", "snapshot", "items", "pagination", "error", "document_hash"],
      "properties": {
        "api_contract": { "const": "price-display-api" }, "api_version": { "const": "v1" },
        "response_kind": { "const": "ERROR" }, "query": { "type": "null" }, "snapshot": { "type": "null" },
        "items": { "type": "array", "maxItems": 0 }, "pagination": { "type": "null" },
        "error": { "$ref": "#/$defs/error" }, "document_hash": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
