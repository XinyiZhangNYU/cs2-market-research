{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/trending-offline-contracts.v1.schema.json",
  "title": "Offline single-item Trending D2 contracts",
  "oneOf": [
    {"$ref": "#/$defs/policy"},
    {"$ref": "#/$defs/membership"},
    {"$ref": "#/$defs/dailyFact"},
    {"$ref": "#/$defs/windowFact"},
    {"$ref": "#/$defs/run"},
    {"$ref": "#/$defs/historicalAdaptation"},
    {"$ref": "#/$defs/catalogFilter"},
    {"$ref": "#/$defs/filteredRanking"}
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "signedRatio": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]*)\\.[0-9]{8}$"
    },
    "sourceCode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$"
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "catalogMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_unit_id",
        "display_name",
        "item_kind",
        "base_item_code",
        "mapping_status",
        "model_code",
        "rarity_code",
        "edition_kind",
        "wear_tier",
        "identity_available_at",
        "projection_sha256"
      ],
      "properties": {
        "analysis_unit_id": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1},
        "item_kind": {"enum": ["WEAPON", "KNIFE", "GLOVE"]},
        "base_item_code": {"type": "string", "minLength": 1},
        "mapping_status": {"enum": ["EXACT", "SCHEMA_UNMATCHED"]},
        "model_code": {"type": ["string", "null"], "minLength": 1},
        "rarity_code": {"type": ["string", "null"], "minLength": 1},
        "edition_kind": {"enum": ["STANDARD", "STATTRAK", "SOUVENIR", "UNKNOWN"]},
        "wear_tier": {"type": ["string", "null"], "minLength": 1},
        "identity_available_at": {"$ref": "#/$defs/timestamp"},
        "projection_sha256": {"$ref": "#/$defs/sha256"},
        "economic_identity": {"$ref": "#/$defs/economicIdentity"}
      },
      "allOf": [
        {
          "if": {"properties": {"mapping_status": {"const": "EXACT"}}},
          "then": {
            "properties": {
              "model_code": {"type": "string", "minLength": 1},
              "rarity_code": {"type": "string", "minLength": 1}
            }
          },
          "else": {
            "properties": {
              "model_code": {"type": "null"},
              "rarity_code": {"type": "null"}
            }
          }
        }
      ]
    },
    "economicIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["definition", "fingerprint_sha256", "evidence_sha256", "available_at"],
      "properties": {
        "fingerprint_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "available_at": {"$ref": "#/$defs/timestamp"},
        "definition": {
          "type": "object", "additionalProperties": false,
          "required": ["analysis_unit_id", "analysis_unit_kind", "parent_analysis_unit_id", "item_kind", "base_item_code", "edition_kind", "wear_tier"],
          "properties": {
            "analysis_unit_id": {"type": "string", "minLength": 1},
            "analysis_unit_kind": {"enum": ["BASE_MHN", "STYLE_VARIANT", "PATTERN_VARIANT"]},
            "parent_analysis_unit_id": {"type": ["string", "null"], "minLength": 1},
            "item_kind": {"enum": ["WEAPON", "KNIFE", "GLOVE"]},
            "base_item_code": {"type": "string", "minLength": 1},
            "edition_kind": {"enum": ["STANDARD", "STATTRAK", "SOUVENIR", "UNKNOWN"]},
            "wear_tier": {"type": ["string", "null"], "minLength": 1}
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "schema_version",
        "policy_version",
        "available_at",
        "source_code",
        "currency",
        "price_scale",
        "horizons_days",
        "minimum_eligible_ratio_bps",
        "minimum_end_to_start_coverage_ratio_bps",
        "minimum_path_coverage_ratio_bps",
        "maximum_consecutive_missing_days",
        "anomaly_abs_change_bps",
        "anomaly_action",
        "knowledge_mode",
        "formal_publication_eligible",
        "public_rights_release_id"
      ],
      "properties": {
        "policy_id": {"$ref": "#/$defs/sha256"},
        "schema_version": {"const": "trending-offline-policy/1"},
        "policy_version": {"type": "string", "minLength": 1},
        "available_at": {"$ref": "#/$defs/timestamp"},
        "source_code": {"$ref": "#/$defs/sourceCode"},
        "currency": {"$ref": "#/$defs/currency"},
        "price_scale": {"type": "integer", "minimum": 0, "maximum": 18},
        "horizons_days": {
          "type": "array",
          "prefixItems": [{"const": 7}, {"const": 14}, {"const": 30}],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "minimum_eligible_ratio_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
        "minimum_end_to_start_coverage_ratio_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
        "minimum_path_coverage_ratio_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
        "maximum_consecutive_missing_days": {"type": "integer", "minimum": 0, "maximum": 30},
        "anomaly_abs_change_bps": {"type": "integer", "minimum": 1},
        "anomaly_action": {"enum": ["INCLUDE_FLAGGED", "WITHHOLD_MEMBER"]},
        "knowledge_mode": {"enum": ["PROSPECTIVE_PIT", "RETROSPECTIVE_LATE_BOUND"]},
        "formal_publication_eligible": {"const": false},
        "public_rights_release_id": {"type": "null"}
      }
    },
    "membership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "membership_id",
        "schema_version",
        "catalog_snapshot_sha256",
        "catalog_version",
        "catalog_as_of",
        "available_at",
        "member_count",
        "member_set_sha256",
        "members"
      ],
      "properties": {
        "membership_id": {"$ref": "#/$defs/sha256"},
        "schema_version": {"const": "trending-offline-membership/1"},
        "catalog_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "catalog_version": {"type": "string", "minLength": 1},
        "catalog_as_of": {"$ref": "#/$defs/timestamp"},
        "available_at": {"$ref": "#/$defs/timestamp"},
        "member_count": {"type": "integer", "minimum": 1},
        "member_set_sha256": {"$ref": "#/$defs/sha256"},
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/catalogMember"}
        }
      }
    },
    "dailyFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id",
        "schema_version",
        "analysis_unit_id",
        "source_code",
        "currency",
        "bucket_date",
        "bucket_closed_at",
        "available_at",
        "source_event_at",
        "price_field",
        "price_atoms",
        "price_scale",
        "catalog_snapshot_sha256",
        "input_record_sha256"
      ],
      "properties": {
        "fact_id": {"$ref": "#/$defs/sha256"},
        "schema_version": {"const": "trending-daily-price-fact/1"},
        "analysis_unit_id": {"type": "string", "minLength": 1},
        "source_code": {"$ref": "#/$defs/sourceCode"},
        "currency": {"$ref": "#/$defs/currency"},
        "bucket_date": {"$ref": "#/$defs/date"},
        "bucket_closed_at": {"$ref": "#/$defs/timestamp"},
        "available_at": {"$ref": "#/$defs/timestamp"},
        "source_event_at": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
        "price_field": {"const": "REFERENCE_ASK"},
        "price_atoms": {"type": ["integer", "null"], "minimum": 0},
        "price_scale": {"type": "integer", "minimum": 0, "maximum": 18},
        "catalog_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "input_record_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "windowFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_fact_id",
        "schema_version",
        "analysis_unit_id",
        "horizon_days",
        "source_code",
        "currency",
        "price_scale",
        "start_date",
        "end_date",
        "evaluated_at",
        "start_fact_id",
        "end_fact_id",
        "start_state",
        "end_state",
        "start_price_atoms",
        "end_price_atoms",
        "change_numerator_units",
        "change_denominator_units",
        "change_ratio",
        "path_expected_days",
        "path_valid_days",
        "path_coverage_bps",
        "longest_missing_streak_days",
        "member_input_sha256",
        "anomaly_flagged",
        "entry_status",
        "exclusion_reason",
        "diagnostic_reasons",
        "gainer_rank",
        "loser_rank"
      ],
      "properties": {
        "window_fact_id": {"$ref": "#/$defs/sha256"},
        "schema_version": {"const": "trending-window-fact/1"},
        "analysis_unit_id": {"type": "string", "minLength": 1},
        "horizon_days": {"enum": [7, 14, 30]},
        "source_code": {"$ref": "#/$defs/sourceCode"},
        "currency": {"$ref": "#/$defs/currency"},
        "price_scale": {"type": "integer", "minimum": 0, "maximum": 18},
        "start_date": {"$ref": "#/$defs/date"},
        "end_date": {"$ref": "#/$defs/date"},
        "evaluated_at": {"$ref": "#/$defs/timestamp"},
        "start_fact_id": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "end_fact_id": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "start_state": {"enum": ["MISSING", "LATE", "NULL", "ZERO", "VALID"]},
        "end_state": {"enum": ["MISSING", "LATE", "NULL", "ZERO", "VALID"]},
        "start_price_atoms": {"type": ["integer", "null"], "minimum": 0},
        "end_price_atoms": {"type": ["integer", "null"], "minimum": 0},
        "change_numerator_units": {"type": ["integer", "null"]},
        "change_denominator_units": {"type": ["integer", "null"], "minimum": 1},
        "change_ratio": {"oneOf": [{"$ref": "#/$defs/signedRatio"}, {"type": "null"}]},
        "path_expected_days": {"type": "integer", "minimum": 8, "maximum": 31},
        "path_valid_days": {"type": "integer", "minimum": 0, "maximum": 31},
        "path_coverage_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
        "longest_missing_streak_days": {"type": "integer", "minimum": 0, "maximum": 31},
        "member_input_sha256": {"$ref": "#/$defs/sha256"},
        "anomaly_flagged": {"type": "boolean"},
        "entry_status": {"enum": ["ELIGIBLE", "EXCLUDED"]},
        "exclusion_reason": {
          "enum": [
            null,
            "MISSING_START",
            "LATE_START",
            "NULL_START",
            "ZERO_START",
            "MISSING_END",
            "LATE_END",
            "NULL_END",
            "ZERO_END",
            "PATH_INCOMPLETE",
            "ANOMALY_REVIEW_REQUIRED"
          ]
        },
        "diagnostic_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "gainer_rank": {"type": ["integer", "null"], "minimum": 1},
        "loser_rank": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "horizonSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "horizon_days",
        "window_status",
        "universe_count",
        "start_valid_count",
        "end_valid_count",
        "eligible_count",
        "excluded_count",
        "eligible_ratio_bps",
        "end_to_start_coverage_ratio_bps",
        "eligible_coverage_gate_passed",
        "endpoint_coverage_gate_passed",
        "exclusion_reason_counts",
        "anomaly_flagged_count"
      ],
      "properties": {
        "horizon_days": {"enum": [7, 14, 30]},
        "window_status": {
          "enum": [
            "INTERNAL_CANDIDATE",
            "WITHHELD_NO_ELIGIBLE",
            "WITHHELD_ELIGIBLE_COVERAGE",
            "WITHHELD_ENDPOINT_COVERAGE"
          ]
        },
        "universe_count": {"type": "integer", "minimum": 1},
        "start_valid_count": {"type": "integer", "minimum": 0},
        "end_valid_count": {"type": "integer", "minimum": 0},
        "eligible_count": {"type": "integer", "minimum": 0},
        "excluded_count": {"type": "integer", "minimum": 0},
        "eligible_ratio_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
        "end_to_start_coverage_ratio_bps": {"type": "integer", "minimum": 0},
        "eligible_coverage_gate_passed": {"type": "boolean"},
        "endpoint_coverage_gate_passed": {"type": "boolean"},
        "exclusion_reason_counts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "anomaly_flagged_count": {"type": "integer", "minimum": 0}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "schema_version",
        "producer_version",
        "policy_id",
        "membership_id",
        "catalog_snapshot_sha256",
        "as_of",
        "evaluated_at",
        "knowledge_mode",
        "source_code",
        "currency",
        "price_scale",
        "daily_fact_count",
        "input_fact_set_sha256",
        "window_fact_count",
        "window_fact_set_sha256",
        "horizon_summaries",
        "overall_status",
        "formal_publication_eligible",
        "public_state_published"
      ],
      "properties": {
        "run_id": {"$ref": "#/$defs/sha256"},
        "schema_version": {"const": "trending-offline-run/1"},
        "producer_version": {"const": "single-item-trending-offline-producer-v1"},
        "policy_id": {"$ref": "#/$defs/sha256"},
        "membership_id": {"$ref": "#/$defs/sha256"},
        "catalog_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "as_of": {"$ref": "#/$defs/date"},
        "evaluated_at": {"$ref": "#/$defs/timestamp"},
        "knowledge_mode": {"enum": ["PROSPECTIVE_PIT", "RETROSPECTIVE_LATE_BOUND"]},
        "source_code": {"$ref": "#/$defs/sourceCode"},
        "currency": {"$ref": "#/$defs/currency"},
        "price_scale": {"type": "integer", "minimum": 0, "maximum": 18},
        "daily_fact_count": {"type": "integer", "minimum": 0},
        "input_fact_set_sha256": {"$ref": "#/$defs/sha256"},
        "window_fact_count": {"type": "integer", "minimum": 3},
        "window_fact_set_sha256": {"$ref": "#/$defs/sha256"},
        "horizon_summaries": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/horizonSummary"}
        },
        "overall_status": {"enum": ["INTERNAL_CANDIDATE", "WITHHELD"]},
        "formal_publication_eligible": {"const": false},
        "public_state_published": {"const": false}
      }
    },
    "historicalInputFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "byte_count", "sha256"],
      "properties": {
        "role": {
          "enum": [
            "catalog_export",
            "catalog_filter_membership",
            "source_daily_buckets"
          ]
        },
        "byte_count": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "historicalSourceCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_code", "row_count"],
      "properties": {
        "source_code": {"$ref": "#/$defs/sourceCode"},
        "row_count": {"type": "integer", "minimum": 1}
      }
    },
    "historicalAdaptation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adaptation_id",
        "schema_version",
        "adapter_version",
        "policy_id",
        "membership_id",
        "catalog_snapshot_sha256",
        "catalog_as_of",
        "membership_available_at",
        "as_of",
        "first_bucket_date",
        "knowledge_mode",
        "source_code",
        "currency",
        "price_scale",
        "input_files",
        "catalog_member_count",
        "exact_mapping_count",
        "unmatched_mapping_count",
        "total_source_rows",
        "source_row_counts",
        "selected_source_row_count",
        "excluded_other_source_rows",
        "selected_member_count",
        "selected_distinct_date_count",
        "selected_null_price_count",
        "selected_zero_price_count",
        "selected_crossed_count",
        "minimum_selected_bucket_date",
        "maximum_selected_bucket_date",
        "maximum_fact_available_at",
        "daily_fact_set_sha256",
        "retained_input_level",
        "raw_provider_payload_included",
        "formal_publication_eligible",
        "public_state_published",
        "public_rights_release_id"
      ],
      "properties": {
        "adaptation_id": {"$ref": "#/$defs/sha256"},
        "schema_version": {"const": "trending-historical-adaptation/1"},
        "adapter_version": {"const": "single-item-trending-historical-adapter-v1"},
        "policy_id": {"$ref": "#/$defs/sha256"},
        "membership_id": {"$ref": "#/$defs/sha256"},
        "catalog_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "catalog_as_of": {"$ref": "#/$defs/timestamp"},
        "membership_available_at": {"$ref": "#/$defs/timestamp"},
        "as_of": {"$ref": "#/$defs/date"},
        "first_bucket_date": {"$ref": "#/$defs/date"},
        "knowledge_mode": {"const": "RETROSPECTIVE_LATE_BOUND"},
        "source_code": {"$ref": "#/$defs/sourceCode"},
        "currency": {"$ref": "#/$defs/currency"},
        "price_scale": {"type": "integer", "minimum": 0, "maximum": 18},
        "input_files": {
          "type": "array",
          "prefixItems": [
            {
              "allOf": [
                {"$ref": "#/$defs/historicalInputFile"},
                {"properties": {"role": {"const": "catalog_export"}}}
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/historicalInputFile"},
                {"properties": {"role": {"const": "catalog_filter_membership"}}}
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/historicalInputFile"},
                {"properties": {"role": {"const": "source_daily_buckets"}}}
              ]
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "catalog_member_count": {"type": "integer", "minimum": 1},
        "exact_mapping_count": {"type": "integer", "minimum": 0},
        "unmatched_mapping_count": {"type": "integer", "minimum": 0},
        "total_source_rows": {"type": "integer", "minimum": 1},
        "source_row_counts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/historicalSourceCount"}
        },
        "selected_source_row_count": {"type": "integer", "minimum": 1},
        "excluded_other_source_rows": {"type": "integer", "minimum": 0},
        "selected_member_count": {"type": "integer", "minimum": 1},
        "selected_distinct_date_count": {"const": 31},
        "selected_null_price_count": {"type": "integer", "minimum": 0},
        "selected_zero_price_count": {"type": "integer", "minimum": 0},
        "selected_crossed_count": {"type": "integer", "minimum": 0},
        "minimum_selected_bucket_date": {"$ref": "#/$defs/date"},
        "maximum_selected_bucket_date": {"$ref": "#/$defs/date"},
        "maximum_fact_available_at": {"$ref": "#/$defs/timestamp"},
        "daily_fact_set_sha256": {"$ref": "#/$defs/sha256"},
        "retained_input_level": {"const": "SOURCE_LEVEL_DAILY_BUCKETS"},
        "raw_provider_payload_included": {"const": false},
        "formal_publication_eligible": {"const": false},
        "public_state_published": {"const": false},
        "public_rights_release_id": {"type": "null"}
      }
    },
    "catalogFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filter_id",
        "schema_version",
        "item_kinds",
        "base_item_codes",
        "mapping_statuses",
        "model_codes",
        "rarity_codes",
        "edition_kinds",
        "wear_tiers"
      ],
      "properties": {
        "filter_id": {"$ref": "#/$defs/sha256"},
        "schema_version": {"const": "trending-catalog-filter/1"},
        "item_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["WEAPON", "KNIFE", "GLOVE"]}
        },
        "base_item_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "mapping_statuses": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["EXACT", "SCHEMA_UNMATCHED"]}
        },
        "model_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "rarity_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "edition_kinds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["STANDARD", "STATTRAK", "SOUVENIR", "UNKNOWN"]}
        },
        "wear_tiers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "filteredRankingEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_unit_id",
        "window_fact_id",
        "query_rank",
        "change_ratio",
        "end_price_atoms",
        "anomaly_flagged"
      ],
      "properties": {
        "analysis_unit_id": {"type": "string", "minLength": 1},
        "window_fact_id": {"$ref": "#/$defs/sha256"},
        "query_rank": {"type": "integer", "minimum": 1},
        "change_ratio": {"$ref": "#/$defs/signedRatio"},
        "end_price_atoms": {"type": "integer", "minimum": 1},
        "anomaly_flagged": {"type": "boolean"}
      }
    },
    "filteredRanking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ranking_id",
        "schema_version",
        "run_id",
        "filter_id",
        "filter",
        "horizon_days",
        "direction",
        "rank_scope",
        "universe_count",
        "eligible_count",
        "excluded_count",
        "exclusion_reason_counts",
        "entries",
        "source_run_overall_status",
        "formal_publication_eligible",
        "public_state_published"
      ],
      "properties": {
        "ranking_id": {"$ref": "#/$defs/sha256"},
        "schema_version": {"const": "trending-filtered-ranking/1"},
