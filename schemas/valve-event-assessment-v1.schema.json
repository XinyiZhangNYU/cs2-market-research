{
  "title": "Valve Event Assessment V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "identity",
    "article",
    "claims",
    "coverage",
    "conclusion_tags",
    "disclosures",
    "provenance"
  ],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "schema_version"],
      "properties": {
        "schema_id": {"type": "string", "const": "valve-event-assessment"},
        "schema_version": {"type": "string", "const": "v1"}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "source_notice_version_id",
        "temporal_mode",
        "event_cutoff_at"
      ],
      "properties": {
        "event_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_notice_version_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "temporal_mode": {
          "type": "string",
          "enum": [
            "PROSPECTIVE",
            "RETROSPECTIVE_REPLAY",
            "RETROSPECTIVE_WITH_HINDSIGHT",
            "RETROSPECTIVE_CORRECTION"
          ]
        },
        "event_cutoff_at": {"type": "string", "minLength": 20, "maxLength": 40}
      }
    },
    "article": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "factual_summary",
        "transmission_mechanisms",
        "scope_analysis",
        "uncertainties_and_counterforces",
        "observation_and_falsification",
        "conclusion"
      ],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "factual_summary": {"type": "string", "minLength": 1, "maxLength": 4000},
        "transmission_mechanisms": {"type": "string", "minLength": 1, "maxLength": 6000},
        "scope_analysis": {"type": "string", "minLength": 1, "maxLength": 6000},
        "uncertainties_and_counterforces": {"type": "string", "minLength": 1, "maxLength": 5000},
        "observation_and_falsification": {"type": "string", "minLength": 1, "maxLength": 5000},
        "conclusion": {"type": "string", "minLength": 1, "maxLength": 3000}
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "scope_kind",
          "scope_ref",
          "scope_display",
          "tracking_status",
          "direction",
          "horizon",
          "mechanism_codes",
          "reasoning_section_ref",
          "observation_targets",
          "falsification_conditions",
          "limitations"
        ],
        "properties": {
          "claim_id": {"type": "string", "minLength": 1, "maxLength": 100},
          "scope_kind": {
            "type": "string",
            "enum": ["MARKET", "SECTOR", "ASSET_FAMILY", "ITEM", "MECHANISM"]
          },
          "scope_ref": {
            "anyOf": [
              {"type": "string", "minLength": 1, "maxLength": 200},
              {"type": "null"}
            ]
          },
          "scope_display": {"type": "string", "minLength": 1, "maxLength": 200},
          "tracking_status": {
            "type": "string",
            "enum": ["TRACKED", "UNTRACKED_SUBJECT", "UNRESOLVED"]
          },
          "direction": {
            "type": "string",
            "enum": ["POSITIVE", "NEGATIVE", "MIXED", "NO_CLEAR_IMPACT", "UNCERTAIN"]
          },
          "horizon": {
            "type": "string",
            "enum": ["IMMEDIATE", "SHORT_TERM", "STRUCTURAL", "UNSPECIFIED"]
          },
          "mechanism_codes": {"$ref": "#/$defs/string_array"},
          "reasoning_section_ref": {
            "type": "string",
            "enum": [
              "title",
              "factual_summary",
              "transmission_mechanisms",
              "scope_analysis",
              "uncertainties_and_counterforces",
              "observation_and_falsification",
              "conclusion"
            ]
          },
          "observation_targets": {"$ref": "#/$defs/string_array"},
          "falsification_conditions": {"$ref": "#/$defs/string_array"},
          "limitations": {"$ref": "#/$defs/string_array"}
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_version",
        "tracked_universe_version",
        "selection_rules_version",
        "context_snapshot_id",
        "context_status",
        "assessed_scopes",
        "excluded_scopes",
        "untracked_subjects",
        "unresolved_subjects",
        "coverage_manifest_sha256"
      ],
      "properties": {
        "catalog_version": {"type": "string", "minLength": 1, "maxLength": 200},
        "tracked_universe_version": {"type": "string", "minLength": 1, "maxLength": 200},
        "selection_rules_version": {"type": "string", "minLength": 1, "maxLength": 200},
        "context_snapshot_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "context_status": {"type": "string", "enum": ["COMPLETE", "PARTIAL", "UNAVAILABLE"]},
        "assessed_scopes": {"$ref": "#/$defs/string_array"},
        "excluded_scopes": {"$ref": "#/$defs/string_array"},
        "untracked_subjects": {"$ref": "#/$defs/string_array"},
        "unresolved_subjects": {"$ref": "#/$defs/string_array"},
        "coverage_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "conclusion_tags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction"],
      "properties": {
        "direction": {
          "type": "string",
          "enum": ["POSITIVE", "NEGATIVE", "MIXED", "NO_CLEAR_IMPACT", "UNCERTAIN"]
        }
      }
    },
    "disclosures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_pack_id",
        "profile_release_id",
        "corpus_release_id",
        "schema_version"
      ],
      "properties": {
        "input_pack_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "profile_release_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "corpus_release_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema_version": {"type": "string", "const": "v1"}
      }
    }
  },
  "$defs": {
    "string_array": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    }
  }
}
