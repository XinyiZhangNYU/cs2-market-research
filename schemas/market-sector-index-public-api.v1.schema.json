{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cs2:market-sector-index-public-api:1",
  "title": "Bounded descriptive market and sector index history",
  "oneOf": [{"$ref": "#/$defs/success"}, {"$ref": "#/$defs/error"}],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "clock": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"},
    "day": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "decimal": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
    "decimalOrNull": {"oneOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
    "count": {"type": "integer", "minimum": 0, "maximum": 1000000},
    "scopeCode": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Z][A-Z0-9_]*(?::[A-Z0-9_]+)?$"},
    "labels": {
      "type": "object", "additionalProperties": false, "required": ["en", "zh_cn"],
      "properties": {"en": {"type": "string", "minLength": 1, "maxLength": 128}, "zh_cn": {"type": "string", "minLength": 1, "maxLength": 128}}
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["scope_token", "scope_code", "scope_kind", "labels", "price_history_eligibility", "first_available_date", "last_available_date", "current_member_count", "observed_price_member_count", "origin_uncertainty_disclosed"],
      "properties": {
        "scope_token": {"$ref": "#/$defs/hash"}, "scope_code": {"$ref": "#/$defs/scopeCode"},
        "scope_kind": {"enum": ["MARKET", "SECTOR", "SUBSECTOR"]}, "labels": {"$ref": "#/$defs/labels"},
        "price_history_eligibility": {"enum": ["RECONSTRUCTED_HISTORY", "FORWARD_ONLY"]},
        "first_available_date": {"oneOf": [{"$ref": "#/$defs/day"}, {"type": "null"}]},
        "last_available_date": {"oneOf": [{"$ref": "#/$defs/day"}, {"type": "null"}]},
        "current_member_count": {"$ref": "#/$defs/count"}, "observed_price_member_count": {"$ref": "#/$defs/count"},
        "origin_uncertainty_disclosed": {"type": "boolean"}
      }
    },
    "point": {
      "type": "object", "additionalProperties": false,
      "required": ["point_id", "date", "segment_id", "connect_to_previous", "availability", "index", "absolute_price", "coverage", "quality", "origin_uncertainty"],
      "properties": {
        "point_id": {"$ref": "#/$defs/hash"}, "date": {"$ref": "#/$defs/day"}, "segment_id": {"type": ["string", "null"]},
        "connect_to_previous": {"type": "boolean"}, "availability": {"enum": ["RECONSTRUCTED_LATE_BOUND", "FORWARD_MEASURED"]},
        "index": {
          "type": "object", "additionalProperties": false, "required": ["value", "period_return", "raw_equal_return", "robust_equal_return", "effective_estimator"],
          "properties": {"value": {"$ref": "#/$defs/decimalOrNull"}, "period_return": {"$ref": "#/$defs/decimalOrNull"}, "raw_equal_return": {"$ref": "#/$defs/decimalOrNull"}, "robust_equal_return": {"$ref": "#/$defs/decimalOrNull"}, "effective_estimator": {"type": ["string", "null"]}}
        },
        "absolute_price": {
          "type": "object", "additionalProperties": false, "required": ["member_minimum_ask_sum_cny", "member_minimum_ask_median_cny", "semantic"],
          "properties": {"member_minimum_ask_sum_cny": {"$ref": "#/$defs/decimalOrNull"}, "member_minimum_ask_median_cny": {"$ref": "#/$defs/decimalOrNull"}, "semantic": {"const": "SUM_AND_MEDIAN_OF_MEMBER_MINIMUM_ASKS_NOT_MARKET_VALUE"}}
        },
        "coverage": {
          "type": "object", "additionalProperties": false, "required": ["expected_member_count", "expected_member_count_upper_bound", "qualified_member_count", "paired_member_count", "coverage_ratio", "coverage_ratio_lower_bound", "absolute_price_qualified_member_count", "absolute_price_coverage_ratio", "absolute_price_coverage_ratio_lower_bound"],
          "properties": {"expected_member_count": {"$ref": "#/$defs/count"}, "expected_member_count_upper_bound": {"$ref": "#/$defs/count"}, "qualified_member_count": {"$ref": "#/$defs/count"}, "paired_member_count": {"$ref": "#/$defs/count"}, "coverage_ratio": {"$ref": "#/$defs/decimal"}, "coverage_ratio_lower_bound": {"$ref": "#/$defs/decimal"}, "absolute_price_qualified_member_count": {"$ref": "#/$defs/count"}, "absolute_price_coverage_ratio": {"$ref": "#/$defs/decimal"}, "absolute_price_coverage_ratio_lower_bound": {"$ref": "#/$defs/decimal"}}
        },
        "quality": {
          "type": "object", "additionalProperties": false, "required": ["overall", "return", "price", "grade_counts", "grade_d_share", "anomaly_member_count", "rejected_return_domain_count", "reason_codes"],
          "properties": {"overall": {"enum": ["HIGH", "PARTIAL", "LOW", "UNAVAILABLE"]}, "return": {"enum": ["HIGH", "PARTIAL", "LOW", "UNAVAILABLE"]}, "price": {"enum": ["HIGH", "PARTIAL", "LOW", "UNAVAILABLE"]}, "grade_counts": {"type": "object", "additionalProperties": false, "required": ["A", "B", "C", "D", "E"], "properties": {"A": {"$ref": "#/$defs/count"}, "B": {"$ref": "#/$defs/count"}, "C": {"$ref": "#/$defs/count"}, "D": {"$ref": "#/$defs/count"}, "E": {"$ref": "#/$defs/count"}}}, "grade_d_share": {"$ref": "#/$defs/decimalOrNull"}, "anomaly_member_count": {"$ref": "#/$defs/count"}, "rejected_return_domain_count": {"$ref": "#/$defs/count"}, "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        "origin_uncertainty": {
          "type": "object", "additionalProperties": false, "required": ["status", "active_uncertain_origin_member_count", "possible_unadmitted_member_count"],
          "properties": {"status": {"enum": ["NONE", "ACTIVE_UNCERTAIN_ORIGIN", "POSSIBLE_UNADMITTED_MEMBERS", "ACTIVE_AND_POSSIBLE_UNCERTAIN_ORIGIN"]}, "active_uncertain_origin_member_count": {"$ref": "#/$defs/count"}, "possible_unadmitted_member_count": {"$ref": "#/$defs/count"}}
        }
      }
    },
    "release": {
      "type": "object", "additionalProperties": false,
      "required": ["publication_id", "manifest_sha256", "rights_revision", "published_at", "withdrawn_at", "series_revision_id", "product_policy_sha256", "source_result_sha256", "history_start", "history_end", "availability_semantic"],
      "properties": {"publication_id": {"$ref": "#/$defs/hash"}, "manifest_sha256": {"$ref": "#/$defs/hash"}, "rights_revision": {"$ref": "#/$defs/hash"}, "published_at": {"$ref": "#/$defs/clock"}, "withdrawn_at": {"oneOf": [{"$ref": "#/$defs/clock"}, {"type": "null"}]}, "series_revision_id": {"type": "string", "pattern": "^market_sector_index_series_[0-9a-f]{64}$"}, "product_policy_sha256": {"$ref": "#/$defs/hash"}, "source_result_sha256": {"$ref": "#/$defs/hash"}, "history_start": {"$ref": "#/$defs/day"}, "history_end": {"$ref": "#/$defs/day"}, "availability_semantic": {"const": "RECONSTRUCTED_LATE_BOUND_NOT_HISTORICALLY_DECISION_AVAILABLE"}}
    },
    "success": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_name", "contract_version", "response_kind", "product_kind", "purpose", "prediction_status", "release", "scope", "query", "points"],
      "properties": {
        "contract_name": {"const": "market-sector-index-public-api"}, "contract_version": {"const": "1"},
        "response_kind": {"enum": ["SCOPE_DIRECTORY", "INDEX_SERIES"]}, "product_kind": {"const": "DESCRIPTIVE_MARKET_SECTOR_INDEX"},
        "purpose": {"const": "CS2_ROTATE_DERIVED_MARKET_SECTOR_INDEX_HISTORY_V1"}, "prediction_status": {"const": "NOT_A_PREDICTION"},
        "release": {"$ref": "#/$defs/release"}, "scope": {"oneOf": [{"$ref": "#/$defs/scope"}, {"type": "null"}]},
        "query": {"type": "object", "additionalProperties": false, "required": ["from_date", "to_date", "after_date", "limit", "next_after_date"], "properties": {"from_date": {"oneOf": [{"$ref": "#/$defs/day"}, {"type": "null"}]}, "to_date": {"oneOf": [{"$ref": "#/$defs/day"}, {"type": "null"}]}, "after_date": {"oneOf": [{"$ref": "#/$defs/day"}, {"type": "null"}]}, "limit": {"type": "integer", "minimum": 1, "maximum": 512}, "next_after_date": {"oneOf": [{"$ref": "#/$defs/day"}, {"type": "null"}]}}},
        "points": {"type": "array", "maxItems": 512, "items": {"$ref": "#/$defs/point"}},
        "scopes": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/scope"}}
      },
      "allOf": [
        {"if": {"properties": {"response_kind": {"const": "SCOPE_DIRECTORY"}}}, "then": {"required": ["scopes"], "properties": {"scope": {"type": "null"}, "points": {"maxItems": 0}}}},
        {"if": {"properties": {"response_kind": {"const": "INDEX_SERIES"}}}, "then": {"properties": {"scope": {"$ref": "#/$defs/scope"}}}}
      ]
    },
    "error": {
      "type": "object", "additionalProperties": false, "required": ["contract_name", "contract_version", "response_kind", "error"],
      "properties": {"contract_name": {"const": "market-sector-index-public-api"}, "contract_version": {"const": "1"}, "response_kind": {"const": "ERROR"}, "error": {"type": "object", "additionalProperties": false, "required": ["code", "retryable"], "properties": {"code": {"enum": ["INVALID_REQUEST", "NOT_PUBLISHED", "NOT_FOUND", "WITHDRAWN", "STALE_EXPIRED", "CORRUPT_PUBLICATION", "TEMPORARILY_UNAVAILABLE"]}, "retryable": {"type": "boolean"}}}}
    }
  }
}
