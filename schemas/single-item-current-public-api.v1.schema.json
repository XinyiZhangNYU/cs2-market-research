{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cs2-research:single-item-current-public-api:v1",
  "title": "Point-in-time single-item current-stage publication",
  "oneOf": [{"$ref": "#/$defs/success"}, {"$ref": "#/$defs/error"}],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"},
    "date": {"type": "string", "format": "date"},
    "publication": {
      "type": "object", "additionalProperties": false,
      "required": ["publication_id", "parent_publication_id", "manifest_sha256", "rights_revision", "published_at", "withdrawn_at"],
      "properties": {
        "publication_id": {"$ref": "#/$defs/sha"},
        "parent_publication_id": {"oneOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
        "manifest_sha256": {"$ref": "#/$defs/sha"},
        "rights_revision": {"$ref": "#/$defs/sha"},
        "published_at": {"$ref": "#/$defs/timestamp"},
        "withdrawn_at": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["expected_slots", "qualified_paired_slots", "longest_missing_run", "quality"],
      "properties": {
        "expected_slots": {"const": 288},
        "qualified_paired_slots": {"type": "integer", "minimum": 0, "maximum": 288},
        "longest_missing_run": {"type": "integer", "minimum": 0, "maximum": 288},
        "quality": {"enum": ["FULL", "HIGH_COVERAGE", "PARTIAL_USABLE"]}
      }
    },
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["catalog_snapshot_id", "membership_version", "input_head_sha256", "source_observed_through", "source_available_through", "imported_at"],
      "properties": {
        "catalog_snapshot_id": {"$ref": "#/$defs/sha"},
        "membership_version": {"$ref": "#/$defs/sha"},
        "input_head_sha256": {"$ref": "#/$defs/sha"},
        "source_observed_through": {"$ref": "#/$defs/date"},
        "source_available_through": {"$ref": "#/$defs/timestamp"},
        "imported_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "release": {
      "type": "object", "additionalProperties": false,
      "required": ["runtime_version", "projection_version", "causal_kernel_version", "policy_sha256", "coverage_policy_version", "full_member_count", "evaluated_member_count", "public_stage_count"],
      "properties": {
        "runtime_version": {"const": "single-item-prospective-runtime/4"},
        "projection_version": {"const": "single-item-prospective-stage/1"},
        "causal_kernel_version": {"const": "single-item-causal-kernel/2.4"},
        "policy_sha256": {"$ref": "#/$defs/sha"},
        "coverage_policy_version": {"$ref": "#/$defs/sha"},
        "full_member_count": {"type": "integer", "minimum": 1, "maximum": 20000},
        "evaluated_member_count": {"type": "integer", "minimum": 0, "maximum": 20000},
        "public_stage_count": {"type": "integer", "minimum": 0, "maximum": 20000}
      }
    },
    "member": {
      "type": "object", "additionalProperties": false,
      "required": ["stage_token", "catalog_snapshot_id", "catalog", "stage", "first_leg", "as_of", "supply_onset", "supply_detected_at", "price_onset", "price_detected_at", "pairing_deadline_on", "timing_relationship", "supply_contraction_ratio", "supply_measurement_confidence", "confidence_is_probability", "bid_role", "coverage", "retrospective_peak", "retrospective_ended_on"],
      "properties": {
        "stage_token": {"$ref": "#/$defs/sha"},
        "catalog_snapshot_id": {"$ref": "#/$defs/sha"},
        "catalog": {"$ref": "urn:cs2-research:catalog-display-api:v1#/$defs/projection"},
        "stage": {"enum": ["SUPPLY_PRESSURE", "PRICE_RESPONSE_ONLY", "PAIRED_RESPONSE"]},
        "first_leg": {"enum": ["SUPPLY", "PRICE"]},
        "as_of": {"$ref": "#/$defs/timestamp"},
        "supply_onset": {"oneOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
        "supply_detected_at": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
        "price_onset": {"oneOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
        "price_detected_at": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
        "pairing_deadline_on": {"$ref": "#/$defs/date"},
        "timing_relationship": {"oneOf": [{"enum": ["SUPPLY_LEADS", "PRICE_LEADS", "CONCURRENT_DAILY"]}, {"type": "null"}]},
        "supply_contraction_ratio": {"oneOf": [{"type": "string", "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$"}, {"type": "null"}]},
        "supply_measurement_confidence": {"enum": ["STANDARD", "LOW_BASELINE_DEPTH"]},
        "confidence_is_probability": {"const": false},
        "bid_role": {"const": "QUOTE_QUALITY_CONTEXT_ONLY"},
        "coverage": {"$ref": "#/$defs/coverage"},
        "retrospective_peak": {"type": "null"},
        "retrospective_ended_on": {"type": "null"}
      }
    },
    "freshness": {
      "type": "object", "additionalProperties": false,
      "required": ["evaluated_at", "expected_latest_complete_date", "lag_complete_days", "status", "headline_data_date"],
      "properties": {
        "evaluated_at": {"$ref": "#/$defs/timestamp"},
        "expected_latest_complete_date": {"$ref": "#/$defs/date"},
        "lag_complete_days": {"type": "integer", "minimum": 0, "maximum": 100000},
        "status": {"enum": ["CURRENT", "STALE_RETAINED"]},
        "headline_data_date": {"$ref": "#/$defs/date"}
      }
    },
    "projection": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot", "release", "empty_reason", "members"],
      "properties": {
        "snapshot": {"$ref": "#/$defs/snapshot"},
        "release": {"$ref": "#/$defs/release"},
        "empty_reason": {"enum": [null, "NO_CURRENT_STAGE"]},
        "members": {"type": "array", "minItems": 0, "maxItems": 20000, "items": {"$ref": "#/$defs/member"}}
      }
    },
    "success": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_name", "contract_version", "response_kind", "operation", "publication", "snapshot", "release", "freshness", "empty_reason", "sort", "page_size", "members", "next_cursor"],
      "properties": {
        "contract_name": {"const": "single-item-current-public-api"},
        "contract_version": {"const": "1"},
        "response_kind": {"enum": ["RESULT", "EMPTY"]},
        "operation": {"enum": ["LIST", "DETAIL"]},
        "publication": {"$ref": "#/$defs/publication"},
        "snapshot": {"$ref": "#/$defs/snapshot"},
        "release": {"$ref": "#/$defs/release"},
        "freshness": {"$ref": "#/$defs/freshness"},
        "empty_reason": {"enum": [null, "NO_CURRENT_STAGE"]},
        "sort": {"enum": ["RELIABLE_SIGNAL_DESC", "DETECTED_DESC", "SUPPLY_CONTRACTION_DESC"]},
        "page_size": {"type": "integer", "minimum": 1, "maximum": 100},
        "members": {"type": "array", "minItems": 0, "maxItems": 100, "items": {"$ref": "#/$defs/member"}},
        "next_cursor": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[A-Za-z0-9_-]+$"}, {"type": "null"}]}
      }
    },
    "error": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_name", "contract_version", "response_kind", "error"],
      "properties": {
        "contract_name": {"const": "single-item-current-public-api"},
        "contract_version": {"const": "1"},
        "response_kind": {"const": "ERROR"},
        "error": {
          "type": "object", "additionalProperties": false,
          "required": ["code", "retryable"],
          "properties": {
            "code": {"enum": ["INVALID_REQUEST", "NOT_PUBLISHED", "NOT_FOUND", "WITHDRAWN", "STALE_EXPIRED", "CORRUPT_PUBLICATION", "TEMPORARILY_UNAVAILABLE"]},
            "retryable": {"type": "boolean"}
          }
        }
      }
    }
  }
}
