{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cs2:market-descriptive-public-api:1",
  "title": "Bounded descriptive MARKET/SECTOR public page facts",
  "oneOf": [{"$ref":"#/$defs/success"},{"$ref":"#/$defs/error"}],
  "$defs": {
    "hash": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "nullableHash": {"oneOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},
    "clock": {"type":"string","format":"date-time","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$","maxLength":27},
    "day": {"type":"string","format":"date","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "decimal": {"type":"string","maxLength":128,"pattern":"^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "nullableDecimal": {"oneOf":[{"$ref":"#/$defs/decimal"},{"type":"null"}]},
    "count": {"type":"integer","minimum":0,"maximum":1000000},
    "scopeId": {"type":"string","minLength":1,"maxLength":64,"pattern":"^[A-Z][A-Z0-9_]*(:[A-Z0-9_]+)?$"},
    "scope": {
      "type":"object","additionalProperties":false,
      "required":["scope_token","scope_id","scope_kind","parent_scope_id","ancestor_scope_ids","labels","fixed_member_count","paired_member_count","day_price_member_count","paired_coverage_ratio","day_price_coverage_ratio","coverage_grade","headline_eligible","raw_return_ratio","suppressed_return_ratio","return_selected_for_display","return_method","missing_endpoint_count","source_set_break_count","single_source_pair_count","unmapped_member_count","other_unavailable_count","member_price_sum_cny","member_price_mean_cny","price_basis"],
      "properties": {
        "scope_token":{"$ref":"#/$defs/hash"}, "scope_id":{"$ref":"#/$defs/scopeId"},
        "scope_kind":{"enum":["MARKET","SECTOR","SUBSECTOR"]},
        "parent_scope_id":{"oneOf":[{"$ref":"#/$defs/scopeId"},{"type":"null"}]},
        "ancestor_scope_ids":{"type":"array","maxItems":8,"uniqueItems":true,"items":{"$ref":"#/$defs/scopeId"}},
        "labels":{"type":"object","additionalProperties":false,"required":["en","zh_cn"],"properties":{"en":{"type":"string","minLength":1,"maxLength":128},"zh_cn":{"type":"string","minLength":1,"maxLength":128}}},
        "fixed_member_count":{"type":"integer","minimum":1,"maximum":1000000},
        "paired_member_count":{"$ref":"#/$defs/count"},"day_price_member_count":{"$ref":"#/$defs/count"},
        "paired_coverage_ratio":{"$ref":"#/$defs/decimal"},"day_price_coverage_ratio":{"$ref":"#/$defs/decimal"},
        "coverage_grade":{"enum":["HIGH","PARTIAL","DETAIL_ONLY"]}, "headline_eligible":{"type":"boolean"},
        "raw_return_ratio":{"$ref":"#/$defs/nullableDecimal"},"suppressed_return_ratio":{"$ref":"#/$defs/nullableDecimal"},
        "return_selected_for_display":{"$ref":"#/$defs/nullableDecimal"},
        "return_method":{"enum":["RAW_EQUAL_MEMBER_RETURN","SYMMETRIC_WINSOR_1_PERCENT"]},
        "missing_endpoint_count":{"$ref":"#/$defs/count"},"source_set_break_count":{"$ref":"#/$defs/count"},
        "single_source_pair_count":{"$ref":"#/$defs/count"},"unmapped_member_count":{"$ref":"#/$defs/count"},"other_unavailable_count":{"$ref":"#/$defs/count"},
        "member_price_sum_cny":{"$ref":"#/$defs/nullableDecimal"},"member_price_mean_cny":{"$ref":"#/$defs/nullableDecimal"},
        "price_basis":{"const":"ONE_SELECTED_EOD_PRICE_PER_AVAILABLE_MEMBER"}
      }
    },
    "dayPair": {
      "type":"object","additionalProperties":false,
      "required":["from_date","to_date","is_adjacent_utc_day","eod_window"],
      "properties":{
        "from_date":{"$ref":"#/$defs/day"},"to_date":{"$ref":"#/$defs/day"},"is_adjacent_utc_day":{"const":true},
        "eod_window":{"type":"object","additionalProperties":false,"required":["expected_slots","minimum_qualified_slots","maximum_latest_slot_age_minutes"],"properties":{"expected_slots":{"const":12},"minimum_qualified_slots":{"const":9},"maximum_latest_slot_age_minutes":{"const":15}}}
      }
    },
    "publication": {
      "type":"object","additionalProperties":false,
      "required":["publication_id","parent_publication_id","manifest_sha256","rights_revision","published_at","withdrawn_at"],
      "properties":{"publication_id":{"$ref":"#/$defs/hash"},"parent_publication_id":{"$ref":"#/$defs/nullableHash"},"manifest_sha256":{"$ref":"#/$defs/hash"},"rights_revision":{"$ref":"#/$defs/hash"},"published_at":{"$ref":"#/$defs/clock"},"withdrawn_at":{"oneOf":[{"$ref":"#/$defs/clock"},{"type":"null"}]},"clock_disclosure":{"oneOf":[{"$ref":"#/$defs/clockDisclosure"},{"type":"null"}]}}
    },
    "clockDisclosure": {
      "type":"object","additionalProperties":false,
      "required":["status","published_at_kind","actual_public_available_at","known_not_before_at","recorded_at","reason"],
      "properties":{"status":{"const":"PREPARED_CLOCK_NOT_ACTUAL"},"published_at_kind":{"const":"PREPARED_VALUE"},"actual_public_available_at":{"type":"null"},"known_not_before_at":{"$ref":"#/$defs/clock"},"recorded_at":{"$ref":"#/$defs/clock"},"reason":{"const":"INITIAL_ACTIVE_APPLY_CLOCK_NOT_OBSERVED"}}
    },
    "snapshot": {
      "type":"object","additionalProperties":false,
      "required":["catalog_snapshot_id","membership_version","input_sha256","start_date","end_date","source_export_as_of","imported_at"],
      "properties":{"catalog_snapshot_id":{"type":"null"},"membership_version":{"type":"string","pattern":"^[a-zA-Z0-9_-]{1,128}$"},"input_sha256":{"$ref":"#/$defs/hash"},"start_date":{"$ref":"#/$defs/day"},"end_date":{"$ref":"#/$defs/day"},"source_export_as_of":{"$ref":"#/$defs/clock"},"imported_at":{"$ref":"#/$defs/clock"}}
    },
    "freshness": {
      "type":"object","additionalProperties":false,
      "required":["evaluated_at","expected_latest_complete_date","lag_complete_days","status","headline_data_date"],
      "properties":{"evaluated_at":{"$ref":"#/$defs/clock"},"expected_latest_complete_date":{"$ref":"#/$defs/day"},"lag_complete_days":{"type":"integer","minimum":0},"status":{"enum":["CURRENT","HISTORICAL_VALUE_DISPLAY_ONLY","NO_RECENT_STATISTIC"]},"headline_data_date":{"oneOf":[{"$ref":"#/$defs/day"},{"type":"null"}]}}
    },
    "quality": {
      "type":"object","additionalProperties":false,
      "required":["date","status","scope"],
      "properties":{"date":{"$ref":"#/$defs/day"},"status":{"enum":["AVAILABLE","NO_PUBLISHED_DAY","UNAVAILABLE","BASELINE_ONLY"]},"scope":{"oneOf":[{"$ref":"#/$defs/scope"},{"type":"null"}]}}
    },
    "headline": {
      "type":"object","additionalProperties":false,"required":["publication_id","day_pair","scope"],
      "properties":{"publication_id":{"$ref":"#/$defs/hash"},"day_pair":{"$ref":"#/$defs/dayPair"},"scope":{"$ref":"#/$defs/scope"}}
    },
    "history": {
      "type":"object","additionalProperties":false,"required":["publication_id","day_pair","scopes","connect_to_previous"],
      "properties":{"publication_id":{"$ref":"#/$defs/hash"},"day_pair":{"$ref":"#/$defs/dayPair"},"scopes":{"type":"array","minItems":1,"maxItems":128,"items":{"$ref":"#/$defs/scope"}},"connect_to_previous":{"type":"boolean"}}
    },
    "success": {
      "type":"object","additionalProperties":false,
      "required":["contract_name","contract_version","response_kind","operation","product_kind","method","publication","snapshot","freshness","day_pair","headline","current_day_quality","scopes","history"],
      "properties":{
        "contract_name":{"const":"market-descriptive-public-api"},"contract_version":{"const":"1"},"response_kind":{"enum":["RESULT","EMPTY"]},
        "operation":{"enum":["OVERVIEW","SCOPE"]},"product_kind":{"const":"MARKET_DESCRIPTIVE"},"method":{"const":"EQUAL_WEIGHTED_MEMBER_RETURN"},
        "publication":{"$ref":"#/$defs/publication"},"snapshot":{"$ref":"#/$defs/snapshot"},"freshness":{"$ref":"#/$defs/freshness"},
        "day_pair":{"oneOf":[{"$ref":"#/$defs/dayPair"},{"type":"null"}]},"headline":{"oneOf":[{"$ref":"#/$defs/headline"},{"type":"null"}]},
        "current_day_quality":{"$ref":"#/$defs/quality"},"scopes":{"type":"array","maxItems":128,"items":{"$ref":"#/$defs/scope"}},
        "history":{"type":"array","maxItems":3,"items":{"$ref":"#/$defs/history"}}
      },
      "allOf":[
        {"if":{"properties":{"response_kind":{"const":"EMPTY"}}},"then":{"properties":{"scopes":{"maxItems":0},"day_pair":{"type":"null"}}}},
        {"if":{"properties":{"response_kind":{"const":"RESULT"}}},"then":{"properties":{"scopes":{"minItems":1},"day_pair":{"$ref":"#/$defs/dayPair"}}}}
      ]
    },
    "error": {
      "type":"object","additionalProperties":false,"required":["contract_name","contract_version","response_kind","error"],
      "properties":{"contract_name":{"const":"market-descriptive-public-api"},"contract_version":{"const":"1"},"response_kind":{"const":"ERROR"},
        "error":{"type":"object","additionalProperties":false,"required":["code","retryable"],"properties":{"code":{"enum":["INVALID_REQUEST","NOT_PUBLISHED","NOT_FOUND","WITHDRAWN","STALE_EXPIRED","CORRUPT_PUBLICATION","TEMPORARILY_UNAVAILABLE"]},"retryable":{"type":"boolean"}}}}
    }
  }
}
