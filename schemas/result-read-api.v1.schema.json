{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cs2-research:result-read-api:v1",
  "title": "CS2 provider-neutral result read API v1",
  "oneOf": [
    { "$ref": "#/$defs/unit_detail" },
    { "$ref": "#/$defs/unit_list" },
    { "$ref": "#/$defs/collection_detail" },
    { "$ref": "#/$defs/quality_detail" },
    { "$ref": "#/$defs/quality_list" },
    { "$ref": "#/$defs/error_response" }
  ],
  "$defs": {
    "storage_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["published_at", "document_hash"],
      "properties": {
        "published_at": {
          "$ref": "urn:cs2-research:research-result-envelope:v1#/$defs/timestamp"
        },
        "document_hash": {
          "$ref": "urn:cs2-research:research-result-envelope:v1#/$defs/sha256"
        }
      }
    },
    "unit_resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope", "storage"],
      "properties": {
        "envelope": {
          "$ref": "urn:cs2-research:research-result-envelope:v1#/$defs/unit_result"
        },
        "storage": { "$ref": "#/$defs/storage_metadata" }
      }
    },
    "collection_resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope", "storage"],
      "properties": {
        "envelope": {
          "$ref": "urn:cs2-research:research-result-envelope:v1#/$defs/collection_result"
        },
        "storage": { "$ref": "#/$defs/storage_metadata" }
      }
    },
    "quality_resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope", "storage"],
      "properties": {
        "envelope": {
          "$ref": "urn:cs2-research:research-quality-envelope:v1"
        },
        "storage": { "$ref": "#/$defs/storage_metadata" }
      }
    },
    "query_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_of",
        "scope_kind",
        "analysis_unit_kind",
        "edition_kind",
        "parent_analysis_unit_id",
        "data_status",
        "sort",
        "page_size"
      ],
      "properties": {
        "as_of": {
          "$ref": "urn:cs2-research:research-result-envelope:v1#/$defs/timestamp"
        },
        "scope_kind": {
          "enum": ["MARKET", "SECTOR", "ITEM", null]
        },
        "analysis_unit_kind": {
          "enum": ["BASE_MHN", "STYLE_VARIANT", "PATTERN_VARIANT", null]
        },
        "edition_kind": {
          "enum": ["STANDARD", "STATTRAK", "SOUVENIR", "UNKNOWN", null]
        },
        "parent_analysis_unit_id": {
          "oneOf": [
            {
              "$ref": "urn:cs2-research:research-result-envelope:v1#/$defs/nonblank_text"
            },
            { "type": "null" }
          ]
        },
        "data_status": {
          "oneOf": [
            {
              "$ref": "urn:cs2-research:research-result-envelope:v1#/$defs/data_status"
            },
            { "type": "null" }
          ]
        },
        "sort": { "const": "ANALYSIS_UNIT_ID_ASC" },
        "page_size": { "type": "integer", "minimum": 1, "maximum": 200 }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "analysis_unit_kind": { "not": { "type": "null" } }
                }
              },
              {
                "properties": {
                  "edition_kind": { "not": { "type": "null" } }
                }
              },
              {
                "properties": {
                  "parent_analysis_unit_id": { "not": { "type": "null" } }
                }
              }
            ]
          },
          "then": {
            "properties": { "scope_kind": { "const": "ITEM" } }
          }
        },
        {
          "if": {
            "properties": {
              "analysis_unit_kind": { "const": "BASE_MHN" }
            },
            "required": ["analysis_unit_kind"]
          },
          "then": {
            "properties": { "parent_analysis_unit_id": { "type": "null" } }
          }
        }
      ]
    },
    "quality_query_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_of",
        "analysis_unit_kind",
        "edition_kind",
        "parent_analysis_unit_id",
        "sort",
        "page_size"
      ],
      "properties": {
        "as_of": {
          "$ref": "urn:cs2-research:research-result-envelope:v1#/$defs/timestamp"
        },
        "analysis_unit_kind": {
          "enum": ["BASE_MHN", "STYLE_VARIANT", "PATTERN_VARIANT", null]
        },
        "edition_kind": {
          "enum": ["STANDARD", "STATTRAK", "SOUVENIR", "UNKNOWN", null]
        },
        "parent_analysis_unit_id": {
          "oneOf": [
            {
              "$ref": "urn:cs2-research:research-result-envelope:v1#/$defs/nonblank_text"
            },
            { "type": "null" }
          ]
        },
        "sort": { "const": "ANALYSIS_UNIT_ID_ASC" },
        "page_size": { "type": "integer", "minimum": 1, "maximum": 200 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "analysis_unit_kind": { "const": "BASE_MHN" }
            },
            "required": ["analysis_unit_kind"]
          },
          "then": {
            "properties": { "parent_analysis_unit_id": { "type": "null" } }
          }
        }
      ]
    },
    "unit_detail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_contract", "api_version", "response_kind", "query_as_of", "resource"
      ],
      "properties": {
        "api_contract": { "const": "result-read-api" },
        "api_version": { "const": "v1" },
        "response_kind": { "const": "UNIT_DETAIL" },
        "query_as_of": {
          "$ref": "urn:cs2-research:research-result-envelope:v1#/$defs/timestamp"
        },
        "resource": { "$ref": "#/$defs/unit_resource" }
      }
    },
    "collection_detail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_contract", "api_version", "response_kind", "query_as_of", "resource"
      ],
      "properties": {
        "api_contract": { "const": "result-read-api" },
        "api_version": { "const": "v1" },
        "response_kind": { "const": "COLLECTION_DETAIL" },
        "query_as_of": {
          "$ref": "urn:cs2-research:research-result-envelope:v1#/$defs/timestamp"
        },
        "resource": { "$ref": "#/$defs/collection_resource" }
      }
    },
    "quality_detail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_contract", "api_version", "response_kind", "query_as_of", "resource"
      ],
      "properties": {
        "api_contract": { "const": "result-read-api" },
        "api_version": { "const": "v1" },
        "response_kind": { "const": "QUALITY_DETAIL" },
        "query_as_of": {
          "$ref": "urn:cs2-research:research-result-envelope:v1#/$defs/timestamp"
        },
        "resource": { "$ref": "#/$defs/quality_resource" }
      }
    },
    "unit_list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_contract", "api_version", "response_kind", "query", "members", "next_cursor"
      ],
      "properties": {
        "api_contract": { "const": "result-read-api" },
        "api_version": { "const": "v1" },
        "response_kind": { "const": "UNIT_LIST" },
        "query": { "$ref": "#/$defs/query_binding" },
        "members": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "#/$defs/unit_resource" }
        },
        "next_cursor": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            { "type": "null" }
          ]
        }
      }
    },
    "quality_list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_contract", "api_version", "response_kind", "query", "members", "next_cursor"
      ],
      "properties": {
        "api_contract": { "const": "result-read-api" },
        "api_version": { "const": "v1" },
        "response_kind": { "const": "QUALITY_LIST" },
        "query": { "$ref": "#/$defs/quality_query_binding" },
        "members": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "#/$defs/quality_resource" }
        },
        "next_cursor": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            { "type": "null" }
          ]
        }
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "http_status", "retryable"],
          "properties": {
            "code": { "enum": ["INVALID_ARGUMENT", "INVALID_CURSOR"] },
            "http_status": { "const": 400 },
            "retryable": { "const": false }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "http_status", "retryable"],
          "properties": {
            "code": { "const": "NOT_FOUND" },
            "http_status": { "const": 404 },
            "retryable": { "const": false }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "http_status", "retryable"],
          "properties": {
            "code": { "enum": ["CONTRACT_UNAVAILABLE", "BACKEND_UNAVAILABLE"] },
            "http_status": { "const": 503 },
            "retryable": { "const": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "http_status", "retryable"],
          "properties": {
            "code": { "const": "RESULT_CORRUPT" },
            "http_status": { "const": 503 },
            "retryable": { "const": false }
          }
        }
      ]
    },
    "error_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_contract", "api_version", "response_kind", "error"],
      "properties": {
        "api_contract": { "const": "result-read-api" },
        "api_version": { "const": "v1" },
        "response_kind": { "const": "ERROR" },
        "error": { "$ref": "#/$defs/error" }
      }
    }
  }
}
