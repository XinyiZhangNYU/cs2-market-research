{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cs2-research:catalog-display-snapshot-api:v1",
  "title": "Catalog display sealed snapshot discovery API V1",
  "oneOf": [
    { "$ref": "#/$defs/listResponse" },
    { "$ref": "#/$defs/errorResponse" }
  ],
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_of",
        "available_at",
        "catalog_version",
        "member_count",
        "member_set_hash",
        "snapshot_id"
      ],
      "properties": {
        "snapshot_id": { "$ref": "#/$defs/sha256" },
        "catalog_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "as_of": { "$ref": "#/$defs/timestamp" },
        "available_at": { "$ref": "#/$defs/timestamp" },
        "member_count": { "type": "integer", "minimum": 0 },
        "member_set_hash": { "$ref": "#/$defs/sha256" }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["known_at", "page_size", "query_as_of", "sort"],
      "properties": {
        "known_at": { "$ref": "#/$defs/timestamp" },
        "page_size": { "type": "integer", "minimum": 1, "maximum": 200 },
        "query_as_of": { "$ref": "#/$defs/timestamp" },
        "sort": { "const": "AS_OF_DESC" }
      }
    },
    "listResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_contract",
        "api_version",
        "members",
        "next_cursor",
        "query",
        "response_kind"
      ],
      "properties": {
        "api_contract": { "const": "catalog-display-snapshot-api" },
        "api_version": { "const": "v1" },
        "response_kind": { "const": "CATALOG_DISPLAY_SNAPSHOT_LIST" },
        "query": { "$ref": "#/$defs/query" },
        "members": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "#/$defs/snapshot" }
        },
        "next_cursor": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            { "type": "null" }
          ]
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_contract", "api_version", "response_kind", "error"],
      "properties": {
        "api_contract": { "const": "catalog-display-snapshot-api" },
        "api_version": { "const": "v1" },
        "response_kind": { "const": "ERROR" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "http_status", "retryable"],
          "properties": {
            "code": {
              "enum": [
                "INVALID_ARGUMENT",
                "INVALID_CURSOR",
                "CONTRACT_UNAVAILABLE",
                "RECORD_CORRUPT",
                "BACKEND_UNAVAILABLE"
              ]
            },
            "http_status": { "enum": [400, 503] },
            "retryable": { "type": "boolean" }
          }
        }
      }
    }
  }
}
