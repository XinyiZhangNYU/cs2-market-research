{
  "title": "Valve reader assessment v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "identity",
    "article",
    "claims",
    "coverage",
    "conclusion_tags",
    "disclosures",
    "provenance",
    "evidence_audit"
  ],
  "properties": {
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version"
      ],
      "properties": {
        "schema_id": {
          "type": "string",
          "const": "valve-event-assessment"
        },
        "schema_version": {
          "type": "string",
          "const": "v2"
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "source_notice_version_id",
        "temporal_mode",
        "event_cutoff_at"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_notice_version_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "temporal_mode": {
          "type": "string",
          "enum": [
            "PROSPECTIVE",
            "RETROSPECTIVE_REPLAY",
            "RETROSPECTIVE_WITH_HINDSIGHT",
            "RETROSPECTIVE_CORRECTION"
          ]
        },
        "event_cutoff_at": {
          "type": "string",
          "minLength": 20,
          "maxLength": 40
        }
      }
    },
    "article": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "body"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12000
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "scope_kind",
          "scope_ref",
          "scope_display",
          "tracking_status",
          "direction",
          "horizon",
          "mechanism_codes",
          "reasoning_section_ref",
          "observation_targets",
          "falsification_conditions",
          "limitations"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "scope_kind": {
            "type": "string",
            "enum": [
              "MARKET",
              "SECTOR",
              "ASSET_FAMILY",
              "ITEM",
              "MECHANISM"
            ]
          },
          "scope_ref": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "scope_display": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "tracking_status": {
            "type": "string",
            "enum": [
              "TRACKED",
              "UNTRACKED_SUBJECT",
              "UNRESOLVED"
            ]
          },
          "direction": {
            "type": "string",
            "enum": [
              "POSITIVE",
              "NEGATIVE",
              "MIXED",
              "NO_CLEAR_IMPACT",
              "UNCERTAIN"
            ]
          },
          "horizon": {
            "type": "string",
            "enum": [
              "IMMEDIATE",
              "SHORT_TERM",
              "STRUCTURAL",
              "UNSPECIFIED"
            ]
          },
          "mechanism_codes": {
            "$ref": "#/$defs/string_array"
          },
          "reasoning_section_ref": {
            "type": "string",
            "enum": [
              "body",
              "evidence_audit"
            ]
          },
          "observation_targets": {
            "$ref": "#/$defs/string_array"
          },
          "falsification_conditions": {
            "$ref": "#/$defs/string_array"
          },
          "limitations": {
            "$ref": "#/$defs/string_array"
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_version",
        "tracked_universe_version",
        "selection_rules_version",
        "context_snapshot_id",
        "context_status",
        "assessed_scopes",
        "excluded_scopes",
        "untracked_subjects",
        "unresolved_subjects",
        "coverage_manifest_sha256"
      ],
      "properties": {
        "catalog_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "tracked_universe_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "selection_rules_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "context_snapshot_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "context_status": {
          "type": "string",
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "UNAVAILABLE"
          ]
        },
        "assessed_scopes": {
          "$ref": "#/$defs/string_array"
        },
        "excluded_scopes": {
          "$ref": "#/$defs/string_array"
        },
        "untracked_subjects": {
          "$ref": "#/$defs/string_array"
        },
        "unresolved_subjects": {
          "$ref": "#/$defs/string_array"
        },
        "coverage_manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "conclusion_tags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction"
      ],
      "properties": {
        "direction": {
          "type": "string",
          "enum": [
            "POSITIVE",
            "NEGATIVE",
            "MIXED",
            "NO_CLEAR_IMPACT",
            "UNCERTAIN"
          ]
        }
      }
    },
    "disclosures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_pack_id",
        "profile_release_id",
        "corpus_release_id",
        "schema_version"
      ],
      "properties": {
        "input_pack_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "profile_release_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "corpus_release_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "schema_version": {
          "type": "string",
          "const": "v2"
        }
      }
    },
    "evidence_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "claim_links"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 21,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidence_id",
              "disposition",
              "note"
            ],
            "properties": {
              "evidence_id": {
                "type": "string",
                "pattern": "^(?:[A-Z][0-9]{2}|TARGET_NOTICE)$"
              },
              "disposition": {
                "type": "string",
                "enum": [
                  "SUPPORTS",
                  "LIMITS",
                  "BACKGROUND",
                  "NOT_RELEVANT"
                ]
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          }
        },
        "claim_links": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claim_id",
              "evidence_ids",
              "summary"
            ],
            "properties": {
              "claim_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "evidence_ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 21,
                "items": {
                  "type": "string",
                  "pattern": "^(?:[A-Z][0-9]{2}|TARGET_NOTICE)$"
                }
              },
              "summary": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "string_array": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    }
  },
  "$id": "valve-event-assessment-v2"
}
