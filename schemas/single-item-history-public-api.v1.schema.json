{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cs2-research:single-item-history-public-api:v1",
  "title": "Bounded retrospective single-item history projection V1",
  "oneOf": [
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_contract",
        "source_manifest_sha256",
        "source_family_events_sha256",
        "catalog_snapshot_id",
        "input_event_count",
        "history_observed_through",
        "imported_at"
      ],
      "properties": {
        "source_contract": {
          "const": "single-item-history-family-relation/2.4"
        },
        "source_manifest_sha256": {
          "$ref": "#/$defs/sha"
        },
        "source_family_events_sha256": {
          "$ref": "#/$defs/sha"
        },
        "catalog_snapshot_id": {
          "$ref": "#/$defs/sha"
        },
        "input_event_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "history_observed_through": {
          "$ref": "#/$defs/date"
        },
        "imported_at": {
          "$ref": "#/$defs/timestamp"
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_id",
        "algorithm_version",
        "causal_kernel_version",
        "source_generator_commit",
        "accepted_verifier_commit",
        "version_contract_sha256",
        "scope",
        "source_event_count",
        "public_event_count",
        "manipulation_labels_enabled"
      ],
      "properties": {
        "release_id": {
          "$ref": "#/$defs/sha"
        },
        "algorithm_version": {
          "const": "single-item-history-reconstruction/2.4"
        },
        "causal_kernel_version": {
          "const": "single-item-causal-kernel/2.4"
        },
        "source_generator_commit": {
          "$ref": "#/$defs/commit"
        },
        "accepted_verifier_commit": {
          "$ref": "#/$defs/commit"
        },
        "version_contract_sha256": {
          "$ref": "#/$defs/sha"
        },
        "display_episode_contract": {
          "const": "single-item-history-display-episode/2"
        },
        "display_episode_policy_sha256": {
          "$ref": "#/$defs/sha"
        },
        "display_episode_lineage_sha256": {
          "$ref": "#/$defs/sha"
        },
        "scope": {
          "const": "HISTORICAL_ANOMALY_CYCLES"
        },
        "source_event_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "public_event_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "manipulation_labels_enabled": {
          "const": false
        }
      },
      "dependentRequired": {
        "display_episode_contract": ["display_episode_policy_sha256", "display_episode_lineage_sha256"],
        "display_episode_policy_sha256": ["display_episode_contract", "display_episode_lineage_sha256"],
        "display_episode_lineage_sha256": ["display_episode_contract", "display_episode_policy_sha256"]
      }
    },
    "representative_native": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "family_event_id",
        "family_cycle_ordinal",
        "timing_relationship",
        "supply_onset",
        "price_onset",
        "pairing_detected_on",
        "statistics_from",
        "statistics_through",
        "peak_on"
      ],
      "properties": {
        "item_id": {"type": "integer", "minimum": 1},
        "family_event_id": {"$ref": "#/$defs/sha"},
        "family_cycle_ordinal": {"type": "integer", "minimum": 1},
        "timing_relationship": {"enum": ["SUPPLY_LEADS", "CONCURRENT_DAILY", "PRICE_LEADS"]},
        "supply_onset": {"$ref": "#/$defs/date"},
        "price_onset": {"$ref": "#/$defs/date"},
        "pairing_detected_on": {"$ref": "#/$defs/date"},
        "statistics_from": {"$ref": "#/$defs/date"},
        "statistics_through": {"$ref": "#/$defs/date"},
        "peak_on": {"$ref": "#/$defs/date"}
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "history_event_token",
        "catalog_snapshot_id",
        "catalog",
        "product_pool",
        "family_cycle_ordinal",
        "timing_relationship",
        "knowledge_mode",
        "supply_onset",
        "price_onset",
        "pairing_detected_on",
        "observed_through",
        "statistics_from",
        "statistics_through",
        "peak_on",
        "baseline_ask_usd",
        "peak_ask_usd",
        "maximum_price_multiple",
        "baseline_supply",
        "minimum_supply",
        "remaining_supply_ratio",
        "supply_contraction_ratio",
        "supply_measurement_confidence",
        "related_variant_count",
        "event_end_is_economic_claim",
        "manipulation_label"
      ],
      "properties": {
        "history_event_token": {
          "$ref": "#/$defs/sha"
        },
        "catalog_snapshot_id": {
          "$ref": "#/$defs/sha"
        },
        "catalog": {
          "$ref": "urn:cs2-research:catalog-display-api:v1#/$defs/projection"
        },
        "product_pool": {
          "enum": ["ORDINARY", "SOUVENIR"]
        },
        "family_cycle_ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "timing_relationship": {
          "enum": ["SUPPLY_LEADS", "CONCURRENT_DAILY", "PRICE_LEADS"]
        },
        "knowledge_mode": {
          "const": "RETROSPECTIVE_LATE_BOUND"
        },
        "supply_onset": {
          "$ref": "#/$defs/date"
        },
        "price_onset": {
          "$ref": "#/$defs/date"
        },
        "pairing_detected_on": {
          "$ref": "#/$defs/date"
        },
        "observed_through": {
          "$ref": "#/$defs/date"
        },
        "statistics_from": {
          "$ref": "#/$defs/date"
        },
        "statistics_through": {
          "$ref": "#/$defs/date"
        },
        "peak_on": {
          "$ref": "#/$defs/date"
        },
        "baseline_ask_usd": {
          "$ref": "#/$defs/decimal"
        },
        "peak_ask_usd": {
          "$ref": "#/$defs/decimal"
        },
        "maximum_price_multiple": {
          "$ref": "#/$defs/decimal"
        },
        "baseline_supply": {
          "$ref": "#/$defs/decimal"
        },
        "minimum_supply": {
          "type": "integer",
          "minimum": 0
        },
        "remaining_supply_ratio": {
          "$ref": "#/$defs/decimal"
        },
        "supply_contraction_ratio": {
          "$ref": "#/$defs/decimal"
        },
        "supply_measurement_confidence": {
          "enum": ["STANDARD", "LOW_BASELINE_DEPTH"]
        },
        "related_variant_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "display_episode_timeline_scope": {
          "const": "DISPLAY_EPISODE_GROUP"
        },
        "display_episode_source_cycle_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "group_timeline_includes_other_variants": {
          "type": "boolean"
        },
        "representative_native": {
          "$ref": "#/$defs/representative_native"
        },
        "event_end_is_economic_claim": {
          "const": false
        },
        "manipulation_label": {
          "type": "null"
        }
      }
    },
    "display_episode_member_requirements": {
      "type": "object",
      "properties": {
        "display_episode_timeline_scope": {},
        "display_episode_source_cycle_count": {},
        "group_timeline_includes_other_variants": {},
        "representative_native": {}
      },
      "required": [
        "display_episode_timeline_scope",
        "display_episode_source_cycle_count",
        "group_timeline_includes_other_variants",
        "representative_native"
      ]
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot", "release", "members"],
      "properties": {
        "snapshot": {
          "$ref": "#/$defs/snapshot"
        },
        "release": {
          "$ref": "#/$defs/release"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/member"
          },
          "maxItems": 100000
        }
      },
      "allOf": [{
        "if": {
          "properties": {"release": {
            "properties": {"display_episode_contract": {"const": "single-item-history-display-episode/2"}},
            "required": ["display_episode_contract"]
          }},
          "required": ["release"]
        },
        "then": {
          "properties": {
            "members": {
              "items": {
                "allOf": [
                  {"$ref": "#/$defs/member"},
                  {"$ref": "#/$defs/display_episode_member_requirements"}
                ]
              }
            }
          }
        }
      }]
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publication_id",
        "parent_publication_id",
        "manifest_sha256",
        "rights_revision",
        "published_at",
        "withdrawn_at"
      ],
      "properties": {
        "publication_id": { "$ref": "#/$defs/sha" },
        "parent_publication_id": {
          "oneOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }]
        },
        "manifest_sha256": { "$ref": "#/$defs/sha" },
        "rights_revision": { "$ref": "#/$defs/sha" },
        "published_at": { "$ref": "#/$defs/timestamp" },
        "withdrawn_at": {
          "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        }
      }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_name",
        "contract_version",
        "response_kind",
        "operation",
        "publication",
        "snapshot",
        "release",
        "sort",
        "page_size",
        "members",
        "next_cursor"
      ],
      "properties": {
        "contract_name": { "const": "single-item-history-public-api" },
        "contract_version": { "const": "1" },
        "response_kind": { "const": "RESULT" },
        "operation": { "enum": ["LIST", "DETAIL"] },
        "publication": { "$ref": "#/$defs/publication" },
        "snapshot": { "$ref": "#/$defs/snapshot" },
        "release": { "$ref": "#/$defs/release" },
        "sort": { "enum": ["MAX_PRICE_MULTIPLE_DESC", "SUPPLY_ONSET_DESC"] },
        "page_size": { "type": "integer", "minimum": 1, "maximum": 100 },
        "members": {
          "type": "array",
          "items": { "$ref": "#/$defs/member" },
          "minItems": 1,
          "maxItems": 100
        },
        "next_cursor": {
          "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 4096 }, { "type": "null" }]
        }
      },
      "allOf": [{
        "if": {
          "properties": {"release": {
            "properties": {"display_episode_contract": {"const": "single-item-history-display-episode/2"}},
            "required": ["display_episode_contract"]
          }},
          "required": ["release"]
        },
        "then": {
          "properties": {
            "members": {
              "items": {
                "allOf": [
                  {"$ref": "#/$defs/member"},
                  {"$ref": "#/$defs/display_episode_member_requirements"}
                ]
              }
            }
          }
        }
      }]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_name", "contract_version", "response_kind", "error"],
      "properties": {
        "contract_name": { "const": "single-item-history-public-api" },
        "contract_version": { "const": "1" },
        "response_kind": { "const": "ERROR" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "retryable"],
          "properties": {
            "code": {
              "enum": [
                "INVALID_REQUEST",
                "NOT_PUBLISHED",
                "NOT_FOUND",
                "WITHDRAWN",
                "STALE_EXPIRED",
                "CORRUPT_PUBLICATION",
                "TEMPORARILY_UNAVAILABLE"
              ]
            },
            "retryable": { "type": "boolean" }
          }
        }
      }
    }
  }
}
