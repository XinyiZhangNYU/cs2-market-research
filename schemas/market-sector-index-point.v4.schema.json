{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.cs2-research.invalid/schemas/market-sector-index-point.v4.schema.json",
  "title": "Market and sector contemporaneously measured index point V4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "point_id", "scope_code", "bucket_date", "series_revision_id",
    "membership_event_ledger_id", "product_policy_sha256", "continuation_spec_sha256",
    "source_ledger_spec_sha256", "source_day_sha256", "source_head_tip_sha256",
    "historical_anchor_publication_id", "historical_anchor_point_id", "membership_binding_sha256",
    "rebalance_effective_date", "rebalance_semantic", "measured_at", "availability_semantic",
    "expected_member_count", "expected_member_count_upper_bound", "possible_unadmitted_member_count",
    "active_uncertain_origin_member_count", "origin_uncertainty_status", "qualified_member_count",
    "paired_member_count", "grade_e_member_count", "rejected_return_domain_count",
    "rejected_return_domain_raw_sum", "coverage_ratio", "coverage_ratio_lower_bound",
    "quality_coverage_ratio", "quality_basis", "quality_status", "return_quality_status",
    "price_quality_status", "raw_equal_return", "robust_equal_return", "effective_estimator",
    "high_confidence_a_equal_return", "high_confidence_a_member_count", "anomaly_member_count",
    "anomaly_contributions", "period_return", "index_value", "segment_id", "grade_counts",
    "grade_counts_semantic", "source_pair_counts", "source_pair_counts_semantic",
    "active_membership_evidence_grade_counts", "grade_d_share",
    "absolute_price_expected_member_count", "absolute_price_expected_member_count_upper_bound",
    "absolute_price_possible_unadmitted_member_count", "absolute_price_qualified_member_count",
    "absolute_price_coverage_ratio", "absolute_price_coverage_ratio_lower_bound",
    "member_minimum_ask_sum_cny", "member_minimum_ask_median_cny",
    "absolute_price_semantic", "reason_codes"
  ],
  "properties": {
    "schema": {"const": "market-sector-index-point/4"},
    "point_id": {"type": "string", "pattern": "^market_sector_index_point_[0-9a-f]{64}$"},
    "scope_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*(?::[A-Z0-9_]+)?$"},
    "bucket_date": {"type": "string", "format": "date"},
    "series_revision_id": {"type": "string", "pattern": "^market_sector_index_series_[0-9a-f]{64}$"},
    "membership_event_ledger_id": {"type": "string", "pattern": "^market_sector_membership_events_[0-9a-f]{64}$"},
    "product_policy_sha256": {"$ref": "#/$defs/hash"},
    "continuation_spec_sha256": {"$ref": "#/$defs/hash"},
    "source_ledger_spec_sha256": {"$ref": "#/$defs/hash"},
    "source_day_sha256": {"$ref": "#/$defs/hash"},
    "source_head_tip_sha256": {"$ref": "#/$defs/hash"},
    "historical_anchor_publication_id": {"$ref": "#/$defs/hash"},
    "historical_anchor_point_id": {"type": "string", "pattern": "^market_sector_index_point_[0-9a-f]{64}$"},
    "membership_binding_sha256": {"$ref": "#/$defs/hash"},
    "rebalance_effective_date": {"type": "string", "format": "date"},
    "rebalance_semantic": {"const": "MONTHLY_MEMBERSHIP_COHORT_OR_RELEASE_EVENT_NOT_SELF_FINANCING_HOLDINGS"},
    "measured_at": {"type": "string", "format": "date-time"},
    "availability_semantic": {"const": "CONTEMPORANEOUSLY_MEASURED_AFTER_SERIES_OPEN"},
    "expected_member_count": {"type": "integer", "minimum": 1},
    "expected_member_count_upper_bound": {"type": "integer", "minimum": 1},
    "possible_unadmitted_member_count": {"$ref": "#/$defs/nonnegative"},
    "active_uncertain_origin_member_count": {"$ref": "#/$defs/nonnegative"},
    "origin_uncertainty_status": {"enum": ["NONE", "ACTIVE_UNCERTAIN_ORIGIN", "POSSIBLE_UNADMITTED_MEMBERS", "ACTIVE_AND_POSSIBLE_UNCERTAIN_ORIGIN"]},
    "qualified_member_count": {"$ref": "#/$defs/nonnegative"},
    "paired_member_count": {"$ref": "#/$defs/nonnegative"},
    "grade_e_member_count": {"$ref": "#/$defs/nonnegative"},
    "rejected_return_domain_count": {"$ref": "#/$defs/nonnegative"},
    "rejected_return_domain_raw_sum": {"$ref": "#/$defs/decimalOrNull"},
    "coverage_ratio": {"$ref": "#/$defs/decimal"},
    "coverage_ratio_lower_bound": {"$ref": "#/$defs/decimal"},
    "quality_coverage_ratio": {"$ref": "#/$defs/decimal"},
    "quality_basis": {"enum": ["RETURN_COVERAGE_LINK", "PRICE_COVERAGE_SEGMENT_BASE"]},
    "quality_status": {"$ref": "#/$defs/quality"},
    "return_quality_status": {"$ref": "#/$defs/quality"},
    "price_quality_status": {"$ref": "#/$defs/quality"},
    "raw_equal_return": {"$ref": "#/$defs/decimalOrNull"},
    "robust_equal_return": {"$ref": "#/$defs/decimalOrNull"},
    "effective_estimator": {"type": ["string", "null"], "enum": ["SYMMETRIC_1_PERCENT_WINSOR", "RAW_EQUAL_ADMITTED_NO_WINSOR", null]},
    "high_confidence_a_equal_return": {"$ref": "#/$defs/decimalOrNull"},
    "high_confidence_a_member_count": {"$ref": "#/$defs/nonnegative"},
    "anomaly_member_count": {"$ref": "#/$defs/nonnegative"},
    "anomaly_contributions": {
      "type": "array", "maxItems": 10,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["analysis_unit_id", "raw_return", "suppressed_return", "adjustment"],
        "properties": {
          "analysis_unit_id": {"type": "string", "minLength": 1},
          "raw_return": {"$ref": "#/$defs/decimal"},
          "suppressed_return": {"$ref": "#/$defs/decimal"},
          "adjustment": {"$ref": "#/$defs/decimal"}
        }
      }
    },
    "period_return": {"$ref": "#/$defs/decimalOrNull"},
    "index_value": {"$ref": "#/$defs/decimalOrNull"},
    "segment_id": {"type": ["string", "null"]},
    "grade_counts": {"$ref": "#/$defs/grades"},
    "grade_counts_semantic": {"const": "SHADOW_DOMAIN_ADMITTED_A_TO_D_PLUS_EXPECTED_UNPAIRED_E"},
    "source_pair_counts": {"$ref": "#/$defs/sourcePairs"},
    "source_pair_counts_semantic": {"const": "ALL_POSITIVE_ADJACENT_PAIRS_BEFORE_SHADOW_DOMAIN_GATE"},
    "active_membership_evidence_grade_counts": {"$ref": "#/$defs/counts"},
    "grade_d_share": {"$ref": "#/$defs/decimalOrNull"},
    "absolute_price_expected_member_count": {"type": "integer", "minimum": 1},
    "absolute_price_expected_member_count_upper_bound": {"type": "integer", "minimum": 1},
    "absolute_price_possible_unadmitted_member_count": {"$ref": "#/$defs/nonnegative"},
    "absolute_price_qualified_member_count": {"$ref": "#/$defs/nonnegative"},
    "absolute_price_coverage_ratio": {"$ref": "#/$defs/decimal"},
    "absolute_price_coverage_ratio_lower_bound": {"$ref": "#/$defs/decimal"},
    "member_minimum_ask_sum_cny": {"$ref": "#/$defs/decimalOrNull"},
    "member_minimum_ask_median_cny": {"$ref": "#/$defs/decimalOrNull"},
    "absolute_price_semantic": {"const": "SUM_AND_MEDIAN_OF_MEMBER_MINIMUM_ASKS_NOT_MARKET_VALUE"},
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonnegative": {"type": "integer", "minimum": 0},
    "decimal": {"type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
    "decimalOrNull": {"anyOf": [{"$ref": "#/$defs/decimal"}, {"type": "null"}]},
    "quality": {"enum": ["HIGH", "PARTIAL", "LOW", "UNAVAILABLE"]},
    "counts": {"type": "object", "additionalProperties": {"$ref": "#/$defs/nonnegative"}},
    "grades": {
      "type": "object", "additionalProperties": false,
      "required": ["A", "B", "C", "D", "E"],
      "properties": {
        "A": {"$ref": "#/$defs/nonnegative"}, "B": {"$ref": "#/$defs/nonnegative"},
        "C": {"$ref": "#/$defs/nonnegative"}, "D": {"$ref": "#/$defs/nonnegative"},
        "E": {"$ref": "#/$defs/nonnegative"}
      }
    },
    "sourcePairs": {
      "type": "object", "propertyNames": {"pattern": "^[1-7]->[1-7]$"},
      "additionalProperties": {"$ref": "#/$defs/nonnegative"}
    }
  }
}
