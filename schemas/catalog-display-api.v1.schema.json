{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cs2-research:catalog-display-api:v1",
  "title": "CS2 safe point-in-time catalog display API V1",
  "oneOf": [
    { "$ref": "#/$defs/listResponse" },
    { "$ref": "#/$defs/errorResponse" }
  ],
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "versionId": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "localizedName": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "en", "zh_cn"],
      "properties": {
        "authority": { "enum": ["VALVE_STEAM", "MARKET_D", "MARKET_B"] },
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "zh_cn": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        }
      }
    },
    "mediaNotProduced": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "const": "NOT_PRODUCED" }
      }
    },
    "mediaBound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "media_key", "presentation_kind"],
      "properties": {
        "status": { "const": "BOUND" },
        "media_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9._-])?(?:/[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9._-])?)*$",
          "maxLength": 256,
          "not": { "pattern": "(^|/)\\.{1,2}(/|$)" }
        },
        "presentation_kind": {
          "enum": ["SERIES_REPRESENTATIVE", "STYLE_REPRESENTATIVE"]
        }
      }
    },
    "media": {
      "oneOf": [
        { "$ref": "#/$defs/mediaNotProduced" },
        { "$ref": "#/$defs/mediaBound" }
      ]
    },
    "versionContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_unit_version_id",
        "item_variant_version_id",
        "media_asset_version_id",
        "name_en_version_id",
        "name_zh_cn_version_id"
      ],
      "properties": {
        "analysis_unit_version_id": { "$ref": "#/$defs/versionId" },
        "item_variant_version_id": { "$ref": "#/$defs/versionId" },
        "media_asset_version_id": {
          "oneOf": [
            { "$ref": "#/$defs/versionId" },
            { "type": "null" }
          ]
        },
        "name_en_version_id": { "$ref": "#/$defs/versionId" },
        "name_zh_cn_version_id": { "$ref": "#/$defs/versionId" }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_unit_id",
        "analysis_unit_kind",
        "base_item_code",
        "catalog_version",
        "edition_kind",
        "item_kind",
        "localized_name",
        "media",
        "parent_analysis_unit_id",
        "projection_hash",
        "valid_from",
        "version_context",
        "wear_tier"
      ],
      "properties": {
        "analysis_unit_id": { "$ref": "#/$defs/identifier" },
        "parent_analysis_unit_id": {
          "oneOf": [
            { "$ref": "#/$defs/identifier" },
            { "type": "null" }
          ]
        },
        "analysis_unit_kind": {
          "enum": ["BASE_MHN", "STYLE_VARIANT", "PATTERN_VARIANT"]
        },
        "item_kind": {
          "enum": ["WEAPON", "KNIFE", "GLOVE", "AGENT", "OTHER", "UNKNOWN"]
        },
        "base_item_code": { "$ref": "#/$defs/identifier" },
        "edition_kind": {
          "enum": ["STANDARD", "STATTRAK", "SOUVENIR", "UNKNOWN"]
        },
        "wear_tier": {
          "enum": [
            "FACTORY_NEW",
            "MINIMAL_WEAR",
            "FIELD_TESTED",
            "WELL_WORN",
            "BATTLE_SCARRED",
            "NOT_APPLICABLE",
            "UNKNOWN"
          ]
        },
        "localized_name": { "$ref": "#/$defs/localizedName" },
        "media": { "$ref": "#/$defs/media" },
        "catalog_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "version_context": { "$ref": "#/$defs/versionContext" },
        "valid_from": { "$ref": "#/$defs/timestamp" },
        "projection_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection", "storage"],
      "properties": {
        "projection": { "$ref": "#/$defs/projection" },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["available_at", "valid_to"],
          "properties": {
            "available_at": { "$ref": "#/$defs/timestamp" },
            "valid_to": {
              "oneOf": [
                { "$ref": "#/$defs/timestamp" },
                { "type": "null" }
              ]
            }
          }
        }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "analysis_unit_kind",
        "as_of",
        "base_item_code",
        "edition_kind",
        "item_kind",
        "known_at",
        "page_size",
        "sort",
        "wear_tier"
      ],
      "properties": {
        "analysis_unit_kind": {
          "oneOf": [
            { "enum": ["BASE_MHN", "STYLE_VARIANT", "PATTERN_VARIANT"] },
            { "type": "null" }
          ]
        },
        "as_of": { "$ref": "#/$defs/timestamp" },
        "base_item_code": {
          "oneOf": [
            { "$ref": "#/$defs/identifier" },
            { "type": "null" }
          ]
        },
        "edition_kind": {
          "oneOf": [
            { "enum": ["STANDARD", "STATTRAK", "SOUVENIR", "UNKNOWN"] },
            { "type": "null" }
          ]
        },
        "item_kind": {
          "oneOf": [
            { "enum": ["WEAPON", "KNIFE", "GLOVE", "AGENT", "OTHER", "UNKNOWN"] },
            { "type": "null" }
          ]
        },
        "known_at": { "$ref": "#/$defs/timestamp" },
        "page_size": { "type": "integer", "minimum": 1, "maximum": 200 },
        "sort": { "const": "ANALYSIS_UNIT_ID_ASC" },
        "wear_tier": {
          "oneOf": [
            {
              "enum": [
                "FACTORY_NEW",
                "MINIMAL_WEAR",
                "FIELD_TESTED",
                "WELL_WORN",
                "BATTLE_SCARRED",
                "NOT_APPLICABLE",
                "UNKNOWN"
              ]
            },
            { "type": "null" }
          ]
        }
      }
    },
    "listResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_contract",
        "api_version",
        "response_kind",
        "query",
        "members",
        "next_cursor"
      ],
      "properties": {
        "api_contract": { "const": "catalog-display-api" },
        "api_version": { "const": "v1" },
        "response_kind": { "const": "CATALOG_DISPLAY_LIST" },
        "query": { "$ref": "#/$defs/query" },
        "members": {
          "type": "array",
          "maxItems": 200,
          "items": { "$ref": "#/$defs/member" }
        },
        "next_cursor": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            { "type": "null" }
          ]
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api_contract", "api_version", "response_kind", "error"],
      "properties": {
        "api_contract": { "const": "catalog-display-api" },
        "api_version": { "const": "v1" },
        "response_kind": { "const": "ERROR" },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "http_status", "retryable"],
          "properties": {
            "code": {
              "enum": [
                "INVALID_ARGUMENT",
                "INVALID_CURSOR",
                "NOT_FOUND",
                "CONTRACT_UNAVAILABLE",
                "RECORD_CORRUPT",
                "BACKEND_UNAVAILABLE"
              ]
            },
            "http_status": { "enum": [400, 404, 503] },
            "retryable": { "type": "boolean" }
          }
        }
      }
    }
  }
}
